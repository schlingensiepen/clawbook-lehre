#!/bin/bash
# Init step of the clawbook-lehre image, run once per container start by
# s6-overlay (as root, before the services start).
#
# 1. Fills the home directory of "student" with the image defaults
#    (only files that do not exist yet - nothing is overwritten) and, on
#    the first start of a new home, the sample project ~/source/samples/primer.
# 2. Creates the keys and the Samba password if they are missing. All of
#    them live in the home directory, so they survive a new image as long
#    as the home volume is kept.
# 3. Shows how to connect, including the private SSH key and the Samba
#    password.
# 4. Prepares the apt package cache in the home volume.
# 5. Notes packages from ~/.clawbook/stand.json that are not installed
#    (after a new image); the service clawbook-restore installs them.
# 6. Once per home: the playwright-cli skill for Claude Code in
#    ~/.claude/skills (marker in ~/.clawbook).
#
# Settings (environment variables, shown only):
#   CLAWBOOK_SSH_PORT  host port mapped to SSH port 22   (default 2222)
#   CLAWBOOK_RDP_PORT  host port mapped to RDP port 3389 (default 3390)

set -euo pipefail

USER_NAME=student
USER_HOME=/home/${USER_NAME}
STATE_DIR=${USER_HOME}/.clawbook
SSH_PORT_SHOWN=${CLAWBOOK_SSH_PORT:-2222}
RDP_PORT_SHOWN=${CLAWBOOK_RDP_PORT:-3390}

# 1. Image defaults (e.g. agent settings) - never overwrite.
chown "${USER_NAME}:${USER_NAME}" "${USER_HOME}"
runuser -u "${USER_NAME}" -- cp -an /opt/clawbook/home-defaults/. "${USER_HOME}/"

# 1b. First start of a new home: sample project in the layout the
#     WorkspaceManager uses (~/source/<topic>/<project>, each a git repo).
#     Only when ~/source does not exist yet, so a deleted sample stays gone.
if [ ! -e "${USER_HOME}/source" ]; then
  PRIMER=${USER_HOME}/source/samples/primer
  runuser -u "${USER_NAME}" -- mkdir -p "${PRIMER}"
  runuser -u "${USER_NAME}" -- cp -a /opt/clawbook/sample-primer/. "${PRIMER}/"
  runuser -u "${USER_NAME}" -- git -C "${PRIMER}" init -q -b main
  runuser -u "${USER_NAME}" -- git -C "${PRIMER}" add -A
  runuser -u "${USER_NAME}" -- git -C "${PRIMER}" \
    -c user.name=clawbook -c user.email=clawbook@localhost \
    commit -q -m "Sample project primer"
fi

# 2a. Machine keys (SSH host key, RDP certificate): root only.
install -d -m 0700 -o root -g root "${STATE_DIR}/ssh-host-keys" "${STATE_DIR}/rdp"
if [ ! -f "${STATE_DIR}/ssh-host-keys/ssh_host_ed25519_key" ]; then
  ssh-keygen -q -t ed25519 -N '' -f "${STATE_DIR}/ssh-host-keys/ssh_host_ed25519_key"
fi
if [ ! -f "${STATE_DIR}/rdp/tls.key" ]; then
  openssl req -x509 -newkey rsa:3072 -nodes -days 3650 \
    -keyout "${STATE_DIR}/rdp/tls.key" -out "${STATE_DIR}/rdp/tls.crt" \
    -subj "/CN=clawbook-rdp" 2>/dev/null
  chmod 0600 "${STATE_DIR}/rdp/tls.key"
fi

# 2b. The user's SSH key: create if missing, show otherwise.
install -d -m 0700 -o "${USER_NAME}" -g "${USER_NAME}" "${USER_HOME}/.ssh"
KEY=${USER_HOME}/.ssh/id_ed25519
if [ ! -f "${KEY}" ]; then
  runuser -u "${USER_NAME}" -- ssh-keygen -q -t ed25519 -N '' \
    -C "${USER_NAME}@clawbook" -f "${KEY}"
  KEY_STATE="neu erzeugt"
else
  KEY_STATE="vorhanden"
fi
AUTH=${USER_HOME}/.ssh/authorized_keys
if ! grep -qsF "$(cat "${KEY}.pub")" "${AUTH}"; then
  cat "${KEY}.pub" >> "${AUTH}"
fi
chown "${USER_NAME}:${USER_NAME}" "${AUTH}"
chmod 0600 "${AUTH}"

# 2c. Samba password of "student": create if missing; the Samba user
#     database is not persistent, so the password is set on every start.
SMB_PW_FILE=${STATE_DIR}/samba-password
if [ ! -f "${SMB_PW_FILE}" ]; then
  # (no "tr </dev/urandom | head": tr gets SIGPIPE and pipefail aborts)
  (umask 077; openssl rand -base64 48 | tr -dc 'A-HJ-NP-Za-km-z2-9' | cut -c1-16 > "${SMB_PW_FILE}")
fi
chown "${USER_NAME}:${USER_NAME}" "${SMB_PW_FILE}"
chmod 0600 "${SMB_PW_FILE}"
SMB_PW=$(cat "${SMB_PW_FILE}")
printf '%s\n%s\n' "${SMB_PW}" "${SMB_PW}" | smbpasswd -a -s "${USER_NAME}" >/dev/null

# 3. Connection details. Samba is only reachable on the podman route
#    (CLAWBOOK_SAMBA=0 hides it, e.g. under WSLC where Windows owns 445).
if [ "${CLAWBOOK_SAMBA:-1}" = 1 ]; then
  SAMBA_LINES=$(printf ' Dateien (Samba):  \\\\<IP der WSL-Distribution>\\%s\n                   Benutzer %s, Passwort %s\n                   (Container mit -p 445:445)\n' "${USER_NAME}" "${USER_NAME}" "${SMB_PW}")
else
  SAMBA_LINES=""
fi
BUILD=$(sed -n 's/^commit=//p' /etc/clawbook-build 2>/dev/null || true)
IPS=$(hostname -I 2>/dev/null || true)
cat <<EOF

================================================================
 clawbook-lehre  (Build ${BUILD:-unbekannt})
================================================================
 Benutzer:         ${USER_NAME}
 IP im Container:  ${IPS:-unbekannt}

 SSH von Windows:  ssh -p ${SSH_PORT_SHOWN} ${USER_NAME}@localhost
                   (Container mit -p 127.0.0.1:${SSH_PORT_SHOWN}:22)
 Bildschirm (RDP): mstsc /v:localhost:${RDP_PORT_SHOWN}
                   (Container mit -p 127.0.0.1:${RDP_PORT_SHOWN}:3389)
${SAMBA_LINES}
 Privater SSH-Schlüssel (${KEY_STATE}) - als Datei speichern,
 z.B. %USERPROFILE%\\.ssh\\clawbook, und mit ssh -i verwenden:
----------------------------------------------------------------
EOF
cat "${KEY}"
cat <<EOF
----------------------------------------------------------------
 Verwaltung:       clawbook  (Werkzeuge prüfen: clawbook check)
================================================================

EOF

# 4. Package cache of apt in the home volume (/etc/apt/apt.conf.d/
#    zz-clawbook-cache): downloaded packages and package lists, owned by
#    root like /var/cache/apt. apt downloads as the user _apt, which must
#    reach "partial" - so the home may be passed (0711), not listed.
chmod 0711 "${USER_HOME}"
chmod o+x "${STATE_DIR}"
install -d -m 0755 -o root -g root "${STATE_DIR}/apt" \
  "${STATE_DIR}/apt/archives" "${STATE_DIR}/apt/lists"
install -d -m 0700 -o _apt -g root \
  "${STATE_DIR}/apt/archives/partial" "${STATE_DIR}/apt/lists/partial"

# 5. Packages from ~/.clawbook/stand.json that this image lacks (e.g. after
#    a new image): only noted here; the service clawbook-restore installs
#    them in the background, so SSH does not wait for it.
/usr/local/bin/clawbook wiederherstellen --pruefen \
  || echo "Warnung: Wiederherstellung der Pakete nicht geprüft (clawbook status)."

# 6. Once per home: "playwright-cli install --skills" in the home, so that
#    Claude Code finds the skill in every project (~/.claude/skills/
#    playwright-cli; it also writes ~/.playwright/cli.config.json with
#    Chromium). The skill ships with the npm package, no download: measured
#    well below a second, also without network. The time limit only guards
#    the start against a hanging call. Without success no marker, so the
#    next start tries again; a skill deleted later stays deleted.
PW_MARKER=${STATE_DIR}/playwright-skill-eingerichtet
if [ ! -e "${PW_MARKER}" ]; then
  # Output to a file, not through $(...): a leftover background process
  # holding the pipe could otherwise keep the start waiting.
  PW_LOG=$(mktemp)
  if (cd "${USER_HOME}" && runuser -u "${USER_NAME}" -- \
        timeout -k 5 60 playwright-cli install --skills </dev/null >"${PW_LOG}" 2>&1) \
     && [ -f "${USER_HOME}/.claude/skills/playwright-cli/SKILL.md" ]; then
    echo "Playwright-Skill für Claude Code eingerichtet: ~/.claude/skills/playwright-cli"
    date -u +%Y-%m-%dT%H:%M:%SZ > "${PW_MARKER}"
    chown "${USER_NAME}:${USER_NAME}" "${PW_MARKER}"
  else
    echo "Warnung: Playwright-Skill nicht eingerichtet (nächster Start versucht es erneut):"
    tail -n 5 "${PW_LOG}"
  fi
  rm -f "${PW_LOG}"
fi
