#!/bin/bash
# Init step of the clawbook-lehre image, run once per container start by
# s6-overlay (as root, before the services start).
#
# 1. Fills the home directory of "student" with the image defaults
#    (only files that do not exist yet - nothing is overwritten).
# 2. Creates the keys and the Samba password if they are missing. All of
#    them live in the home directory, so they survive a new image as long
#    as the home volume is kept.
# 3. Shows how to connect, including the private SSH key and the Samba
#    password.
#
# Settings (environment variables, shown only):
#   CLAWBOOK_SSH_PORT  host port mapped to SSH port 22   (default 2222)
#   CLAWBOOK_RDP_PORT  host port mapped to RDP port 3389 (default 3390)

set -euo pipefail

USER_NAME=student
USER_HOME=/home/${USER_NAME}
STATE_DIR=${USER_HOME}/.clawbook
SSH_PORT_SHOWN=${CLAWBOOK_SSH_PORT:-2222}
RDP_PORT_SHOWN=${CLAWBOOK_RDP_PORT:-3390}

# 1. Image defaults (e.g. agent settings) - never overwrite.
chown "${USER_NAME}:${USER_NAME}" "${USER_HOME}"
runuser -u "${USER_NAME}" -- cp -an /opt/clawbook/home-defaults/. "${USER_HOME}/"

# 2a. Machine keys (SSH host key, RDP certificate): root only.
install -d -m 0700 -o root -g root "${STATE_DIR}/ssh-host-keys" "${STATE_DIR}/rdp"
if [ ! -f "${STATE_DIR}/ssh-host-keys/ssh_host_ed25519_key" ]; then
  ssh-keygen -q -t ed25519 -N '' -f "${STATE_DIR}/ssh-host-keys/ssh_host_ed25519_key"
fi
if [ ! -f "${STATE_DIR}/rdp/tls.key" ]; then
  openssl req -x509 -newkey rsa:3072 -nodes -days 3650 \
    -keyout "${STATE_DIR}/rdp/tls.key" -out "${STATE_DIR}/rdp/tls.crt" \
    -subj "/CN=clawbook-rdp" 2>/dev/null
  chmod 0600 "${STATE_DIR}/rdp/tls.key"
fi

# 2b. The user's SSH key: create if missing, show otherwise.
install -d -m 0700 -o "${USER_NAME}" -g "${USER_NAME}" "${USER_HOME}/.ssh"
KEY=${USER_HOME}/.ssh/id_ed25519
if [ ! -f "${KEY}" ]; then
  runuser -u "${USER_NAME}" -- ssh-keygen -q -t ed25519 -N '' \
    -C "${USER_NAME}@clawbook" -f "${KEY}"
  KEY_STATE="neu erzeugt"
else
  KEY_STATE="vorhanden"
fi
AUTH=${USER_HOME}/.ssh/authorized_keys
if ! grep -qsF "$(cat "${KEY}.pub")" "${AUTH}"; then
  cat "${KEY}.pub" >> "${AUTH}"
fi
chown "${USER_NAME}:${USER_NAME}" "${AUTH}"
chmod 0600 "${AUTH}"

# 2c. Samba password of "student": create if missing; the Samba user
#     database is not persistent, so the password is set on every start.
SMB_PW_FILE=${STATE_DIR}/samba-password
if [ ! -f "${SMB_PW_FILE}" ]; then
  # (no "tr </dev/urandom | head": tr gets SIGPIPE and pipefail aborts)
  (umask 077; openssl rand -base64 48 | tr -dc 'A-HJ-NP-Za-km-z2-9' | cut -c1-16 > "${SMB_PW_FILE}")
fi
chown "${USER_NAME}:${USER_NAME}" "${SMB_PW_FILE}"
chmod 0600 "${SMB_PW_FILE}"
SMB_PW=$(cat "${SMB_PW_FILE}")
printf '%s\n%s\n' "${SMB_PW}" "${SMB_PW}" | smbpasswd -a -s "${USER_NAME}" >/dev/null

# 3. Connection details. Samba is only reachable on the podman route
#    (CLAWBOOK_SAMBA=0 hides it, e.g. under WSLC where Windows owns 445).
if [ "${CLAWBOOK_SAMBA:-1}" = 1 ]; then
  SAMBA_LINES=$(printf ' Dateien (Samba):  \\\\<IP der WSL-Distribution>\\%s\n                   Benutzer %s, Passwort %s\n                   (Container mit -p 445:445)\n' "${USER_NAME}" "${USER_NAME}" "${SMB_PW}")
else
  SAMBA_LINES=""
fi
BUILD=$(sed -n 's/^commit=//p' /etc/clawbook-build 2>/dev/null || true)
IPS=$(hostname -I 2>/dev/null || true)
cat <<EOF

================================================================
 clawbook-lehre  (Build ${BUILD:-unbekannt})
================================================================
 Benutzer:         ${USER_NAME}
 IP im Container:  ${IPS:-unbekannt}

 SSH von Windows:  ssh -p ${SSH_PORT_SHOWN} ${USER_NAME}@localhost
                   (Container mit -p 127.0.0.1:${SSH_PORT_SHOWN}:22)
 Bildschirm (RDP): mstsc /v:localhost:${RDP_PORT_SHOWN}
                   (Container mit -p 127.0.0.1:${RDP_PORT_SHOWN}:3389)
${SAMBA_LINES}
 Privater SSH-Schlüssel (${KEY_STATE}) - als Datei speichern,
 z.B. %USERPROFILE%\\.ssh\\clawbook, und mit ssh -i verwenden:
----------------------------------------------------------------
EOF
cat "${KEY}"
cat <<EOF
----------------------------------------------------------------
 Werkzeuge prüfen: clawbook-check
================================================================

EOF
