#!/bin/bash
# Checks that every tool of the image is present and reports its version.
# Kept as a thin wrapper: the checks live in "clawbook check".
# Exit code 0 when all tools answer, 1 otherwise.
#
#   clawbook-check          table of all tools
#   clawbook-check --quiet  only failures
#   clawbook-check --json   JSON list (name, version, ok)
exec /usr/local/bin/clawbook check "$@"
