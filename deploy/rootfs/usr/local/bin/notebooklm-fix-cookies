#!/usr/bin/env python3
"""Copy fresh cookies from notebook.google.com to notebooklm.google.com.

Google moved NotebookLM from notebooklm.google.com to notebook.google.com.
The CLI (notebooklm-py) still expects the old domain. Run this script
after every `notebooklm login`; "clawbook notebooklm anmelden" runs it
itself and passes the path of the file.

    notebooklm-fix-cookies [PATH]

Without PATH the script looks in the default places of notebooklm. The
file is replaced atomically (mode 0600); no backup copy is left behind.
"""

import json
import os
import sys
from pathlib import Path

STORAGE_PATHS = [
    Path.home() / ".notebooklm" / "profiles" / "default" / "storage_state.json",
    Path.home() / ".notebooklm" / "storage_state.json",
]


def find_storage():
    for p in STORAGE_PATHS:
        if p.exists():
            return p
    return None


def write_atomic(path, data):
    """Writes data next to path (0600, fsync) and moves it into place."""
    tmp = path.with_name(path.name + ".neu")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            fd = None
            json.dump(data, f, indent=2)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        if fd is not None:
            os.close(fd)
        try:
            tmp.unlink()
        except OSError:
            pass
        raise


def fix_cookies(path):
    with open(path, encoding="utf-8") as f:
        data = json.load(f)

    cookies = data.get("cookies", [])
    nb = {c["name"]: c for c in cookies if c.get("domain") == "notebook.google.com"}

    if not nb:
        print("No notebook.google.com cookies found - run `clawbook notebooklm anmelden` first.")
        return False

    updated = 0
    for c in cookies:
        if c.get("domain") == "notebooklm.google.com" and c["name"] in nb:
            c["value"] = nb[c["name"]]["value"]
            c["expires"] = nb[c["name"]].get("expires", c.get("expires"))
            updated += 1

    if not updated:
        for name, src in nb.items():
            clone = dict(src)
            clone["domain"] = "notebooklm.google.com"
            cookies.append(clone)
            updated += 1

    origins = data.get("origins", [])
    nb_origin = next((o for o in origins if o.get("origin") == "https://notebook.google.com"), None)
    nlm_origin = next((o for o in origins if o.get("origin") == "https://notebooklm.google.com"), None)

    if nb_origin and not nlm_origin:
        origins.append({
            "origin": "https://notebooklm.google.com",
            "localStorage": list(nb_origin.get("localStorage", []))
        })

    write_atomic(Path(path), data)

    print(f"OK - copied {updated} cookies from notebook.google.com to notebooklm.google.com.")
    return True


def main():
    if len(sys.argv) > 2 or sys.argv[1:2] in (["-h"], ["--help"]):
        print(__doc__.strip())
        sys.exit(0 if len(sys.argv) == 2 else 2)
    path = Path(sys.argv[1]) if len(sys.argv) == 2 else find_storage()
    if not path or not path.exists():
        print(f"storage_state.json not found{f': {path}' if path else '.'}", file=sys.stderr)
        sys.exit(1)

    if fix_cookies(path):
        sys.exit(0)
    else:
        sys.exit(1)


if __name__ == "__main__":
    main()
