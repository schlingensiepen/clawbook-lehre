#!/bin/bash
# wsm (WorkspaceManager) with a GitHub check in front.
#
# On its first run wsm writes ~/.workspacemanager.yml and takes the GitHub
# name from "gh". Without a gh login it asks for the name and stores
# "student" when nothing is typed. So: as long as the config is missing
# and gh is not logged in, the GitHub login comes first (with the option
# to cancel). Without a terminal nothing is asked; the arguments always go
# to the real wsm unchanged.
#
# An existing configuration of wsm 1.0 (a single location ~/source) is
# never replaced by wsm itself; clawbook offers once to renew it ("clawbook
# wsm erneuern --vor-wsm", asks only with a terminal and a GitHub login,
# never stops wsm). Saying no leaves the marker below in ~/.clawbook. The
# grep is only a cheap pre-filter (a "path: ~/source" line); clawbook
# decides.
#
# The real wsm lives in /opt/clawbook/tool-bin (see deploy/Containerfile).
REAL=/opt/clawbook/tool-bin/wsm
# A line "path: ~/source" (also /home/<user>/source, $HOME/source, quoted).
OLD_CONFIG_RE="^[[:space:]]*(-[[:space:]]+)?path:[[:space:]]*[\"']?(~|/home/[^/]+|[\$]HOME|[\$][{]HOME[}])/source/?[\"']?[[:space:]]*\$"

check=1
for arg in "$@"; do
  case "${arg}" in
    -h|--help|--version) check=0 ;;
  esac
done

if [ "${check}" = 1 ] && [ -t 0 ] && [ -t 1 ] && [ "$(id -u)" != 0 ] \
   && [ ! -e "${HOME}/.workspacemanager.yml" ] \
   && ! gh auth status --hostname github.com >/dev/null 2>&1; then
  /usr/local/bin/clawbook github login --vor-wsm || exit 1
fi

if [ "${check}" = 1 ] && [ -t 0 ] && [ -t 1 ] && [ "$(id -u)" != 0 ] \
   && [ -e "${HOME}/.workspacemanager.yml" ] \
   && [ ! -e "${HOME}/.clawbook/wsm-konfiguration-behalten" ] \
   && grep -Eq "${OLD_CONFIG_RE}" "${HOME}/.workspacemanager.yml"; then
  /usr/local/bin/clawbook wsm erneuern --vor-wsm || true
fi

exec "${REAL}" "$@"
