Mit --json gibt clawbook nur JSON aus (für das Windows-Skript).
"""


class CliError(Exception):
    """Error shown to the user; exit code attached."""

    def __init__(self, message, code=1):
        super().__init__(message)
        self.code = code


# --- helpers ---------------------------------------------------------------

def user_info():
    try:
        return pwd.getpwnam(USER_NAME)
    except KeyError:
        raise CliError(f"Den Benutzer {USER_NAME} gibt es hier nicht.")


def user_home():
    return user_info().pw_dir


def state_dir():
    return os.path.join(user_home(), ".clawbook")


def key_path():
    return os.path.join(user_home(), ".ssh", "id_ed25519")


def run(cmd, timeout=60, stdin=subprocess.DEVNULL, env=None):
    """Runs a command; returns (exit code, stdout+stderr as text).
    env: extra environment variables."""
    full_env = dict(os.environ, **env) if env else None
    try:
        p = subprocess.run(cmd, stdin=stdin, stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT, timeout=timeout, env=full_env)
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, str(e)
    return p.returncode, p.stdout.decode("utf-8", "replace")


def run_stdout(cmd, timeout=60):
    """Like run(), but returns only stdout (stderr is dropped) - for
    commands whose stdout is parsed as JSON."""
    try:
        p = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, str(e)
    return p.returncode, p.stdout.decode("utf-8", "replace")


def read_build():
    """Contents of /etc/clawbook-build as dict (commit, built, ...)."""
    data = {}
    try:
        with open(BUILD_FILE, encoding="utf-8") as f:
            for line in f:
                if "=" in line:
                    k, v = line.rstrip("\n").split("=", 1)
                    data[k.strip()] = v.strip()
    except OSError:
        pass
    return data


def image_version(build):
    """Image version if the image knows it (build stamp or environment)."""
    return build.get("version") or os.environ.get("CLAWBOOK_VERSION") or None


def chown_to_user(path):
    """When running as root, hand the path over to the working user."""
    if os.geteuid() == 0:
        u = user_info()
        os.chown(path, u.pw_uid, u.pw_gid)


def write_user_file(path, text, mode=0o644):
    """Writes a file in the user's home atomically, owned by the user.

    Falls back to sudo when the directory is not writable for the caller
    (e.g. ~/.clawbook created by root in the start script)."""
    directory = os.path.dirname(path)
    if not os.path.isdir(directory):
        if os.access(os.path.dirname(directory), os.W_OK):
            os.makedirs(directory, exist_ok=True)
            chown_to_user(directory)
        else:
            rc, out = run(["sudo", "-n", "install", "-d", "-o", USER_NAME,
                           "-g", USER_NAME, directory])
            if rc != 0:
                raise CliError(f"Kann {directory} nicht anlegen: {out.strip()}")
    if os.access(directory, os.W_OK):
        fd, tmp = tempfile.mkstemp(dir=directory, prefix=".tmp-")
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(text)
            os.chmod(tmp, mode)
            chown_to_user(tmp)
            os.replace(tmp, path)
        except BaseException:
            if os.path.exists(tmp):
                os.unlink(tmp)
            raise
        return
    fd, tmp = tempfile.mkstemp(prefix="clawbook-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        rc, out = run(["sudo", "-n", "install", "-o", USER_NAME, "-g", USER_NAME,
                       "-m", f"{mode:o}", tmp, path])
        if rc != 0:
            raise CliError(f"Kann {path} nicht schreiben: {out.strip()}")
    finally:
        os.unlink(tmp)


def dump_json(data):
    # ASCII only: the Windows script (PowerShell 5.1) reads it safely in
    # any code page; umlauts arrive as \\u escapes.
    return json.dumps(data, indent=2, ensure_ascii=True) + "\n"


def ask_yes(question):
    try:
        answer = input(f"{question} [j/N] ").strip().lower()
    except EOFError:
        return False
    return answer in ("j", "ja", "y", "yes")


def ask_yes_default(question):
    """Like ask_yes, but Enter means yes."""
    try:
        answer = input(f"{question} [J/n] ").strip().lower()
    except EOFError:
        return False
    return answer in ("", "j", "ja", "y", "yes")


def human_bytes(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.1f} {unit}" if unit != "B" else f"{n} B"
        n /= 1024
    return f"{n} B"


# --- status ----------------------------------------------------------------

def service_running(name):
    rc, _ = run(["pgrep", "-x", name], timeout=10)
    return rc == 0


def home_is_mount(path):
    """True when the home directory is a mount point of its own (volume)."""
    try:
        with open("/proc/self/mountinfo", encoding="utf-8") as f:
            for line in f:
                fields = line.split()
                if len(fields) > 4 and fields[4] == path:
                    return True
    except OSError:
        pass
    return os.path.ismount(path)


# "wiederherstellung" in "status --json" (ASCII-escaped in the JSON).
RESTORE_WORD = {"laeuft": "läuft", "fertig": "fertig", "fehler": "fehler"}


def collect_status():
    build = read_build()
    home = user_home()
    usage = shutil.disk_usage(home)
    data = {
        "schnittstelle": SCHNITTSTELLE,
        "build": {"commit": build.get("commit"), "erstellt": build.get("built")},
        "image": image_version(build),
        "benutzer": USER_NAME,
        "aufgerufen_als": pwd.getpwuid(os.geteuid()).pw_name,
        "dienste": {name: service_running(name) for name in SERVICES},
        "home": {
            "pfad": home,
            "eigenes_volume": home_is_mount(home),
            "gesamt_bytes": usage.total,
            "belegt_bytes": usage.used,
            "frei_bytes": usage.free,
        },
        "paket_cache": {
            "pfad": os.path.join(apt_dir(), "archives"),
            "bytes": dir_size(os.path.join(apt_dir(), "archives")),
            "listen_bytes": dir_size(os.path.join(apt_dir(), "lists")),
        },
        "wiederherstellung_details": restore_summary(),
    }
    # Short form for the Windows script: missing = nothing to restore.
    zustand = data["wiederherstellung_details"]["zustand"]
    if zustand != "keine":
        data["wiederherstellung"] = RESTORE_WORD[zustand]
    return data


def cmd_status(opts):
    s = collect_status()
    if opts["json"]:
        sys.stdout.write(dump_json(s))
        return 0
    h = s["home"]
    print("clawbook - Status")
    print(f"  Schnittstelle:  {s['schnittstelle']}")
    print(f"  Build:          {s['build']['commit'] or 'unbekannt'}"
          f"  ({s['build']['erstellt'] or 'Datum unbekannt'})")
    print(f"  Image-Version:  {s['image'] or 'unbekannt'}")
    print(f"  Benutzer:       {s['benutzer']} (aufgerufen als {s['aufgerufen_als']})")
    for name, ok in s["dienste"].items():
        print(f"  Dienst {name + ':':8} {'läuft' if ok else 'läuft NICHT'}")
    vol = "eigenes Volume" if h["eigenes_volume"] else "kein eigenes Volume"
    print(f"  Home:           {h['pfad']} ({vol})")
    print(f"                  belegt {human_bytes(h['belegt_bytes'])} von "
          f"{human_bytes(h['gesamt_bytes'])}, frei {human_bytes(h['frei_bytes'])}")
    c = s["paket_cache"]
    print(f"  Paket-Cache:    {human_bytes(c['bytes'])} in {c['pfad']}"
          f" (Paketlisten {human_bytes(c['listen_bytes'])})")
    print(f"  Wiederherstellung: {restore_text(s['wiederherstellung_details'])}")
    return 0


RESTORE_TEXT = {"keine": "nicht nötig", "laeuft": "läuft", "fertig": "fertig",
                "fehler": "FEHLER"}


def restore_text(r):
    text = RESTORE_TEXT.get(r["zustand"], r["zustand"])
    if r["pakete"] and r["zustand"] != "keine":
        text += f" ({', '.join(r['pakete'])})"
    if r["zustand"] == "fertig" and r.get("download"):
        text += f", Download {r['download']}"
    if r.get("meldung"):
        text += f"\n                  {r['meldung']}"
    if r["zustand"] == "fehler":
        text += "\n                  erneut versuchen: clawbook wiederherstellen"
    elif r["zustand"] == "laeuft":
        text += f"\n                  Fortschritt: {r['log']}"
    return text


# --- check -----------------------------------------------------------------

def check_tool(cmd):
    """(ok, first output line) - ok when the command succeeds with output."""
    rc, out = run(cmd, timeout=120)
    first = out.splitlines()[0].strip() if out.strip() else ""
    return rc == 0 and first != "", first


def collect_checks():
    """Tool checks plus the NotebookLM login (local check only, no network).
    The login line is information, never a failure: "ok" stays True."""
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        nlm = pool.submit(notebooklm_state)
        results = list(pool.map(lambda t: check_tool(t[1]), TOOLS))
        nlm = nlm.result()
    checks = [{"name": name, "version": first if ok else None, "ok": ok,
               "befehl": " ".join(cmd)}
              for (name, cmd), (ok, first) in zip(TOOLS, results)]
    checks.append({"name": "notebooklm-anmeldung", "version": NLM_TEXT[nlm["zustand"]],
                   "ok": True, "zustand": nlm["zustand"], "befehl": "clawbook notebooklm",
                   "anzeige": "NotebookLM", "hinweis": NLM_CHECK_HINT.get(nlm["zustand"], "")})
    return checks


def cmd_check(opts):
    checks = collect_checks()
    failed = any(not c["ok"] for c in checks)
    if opts["json"]:
        sys.stdout.write(dump_json([dict({"name": c["name"], "version": c["version"],
                                          "ok": c["ok"]},
                                         **({"zustand": c["zustand"]} if "zustand" in c else {}))
                                    for c in checks]))
        return 1 if failed else 0
    if not opts["quiet"]:
        print("clawbook-lehre - Werkzeuge")
        try:
            with open(BUILD_FILE, encoding="utf-8") as f:
                for line in f:
                    print("  " + line.rstrip("\n"))
        except OSError:
            pass
    for c in checks:
        if c["ok"]:
            if not opts["quiet"]:
                print(f"  {c.get('anzeige', c['name']):<16} {c['version']}{c.get('hinweis', '')}")
        else:
            print(f"  {c['name']:<16} FEHLT ({c['befehl']})")
    return 1 if failed else 0


# --- key -------------------------------------------------------------------

def key_info():
    key = key_path()
    if not os.path.isfile(key + ".pub"):
        raise CliError(f"Es gibt noch keinen Schlüssel ({key}). Er entsteht beim "
                       "Start des Containers oder mit: clawbook key new")
    with open(key + ".pub", encoding="utf-8") as f:
        public = f.read().strip()
    rc, out = run(["ssh-keygen", "-lf", key + ".pub"])
    fingerprint = out.strip() if rc == 0 else None
    return {"datei": key, "oeffentlich": public, "fingerabdruck": fingerprint}


def read_private_key():
    key = key_path()
    try:
        with open(key, encoding="utf-8") as f:
            return f.read()
    except PermissionError:
        rc, out = run(["sudo", "-n", "cat", key])
        if rc != 0:
            raise CliError(f"Kann {key} nicht lesen.")
        return out
    except OSError:
        raise CliError(f"Es gibt keinen privaten Schlüssel {key}.")


def cmd_key_show(opts):
    info = key_info()
    if opts["private"]:
        private = read_private_key()
        if opts["json"]:
            sys.stdout.write(dump_json({"datei": info["datei"], "privat": private,
                                        "fingerabdruck": info["fingerabdruck"]}))
        else:
            sys.stdout.write(private)
        return 0
    if opts["json"]:
        sys.stdout.write(dump_json(info))
        return 0
    print(f"Öffentlicher Schlüssel ({info['datei']}.pub):")
    print(f"  {info['oeffentlich']}")
    print(f"Fingerabdruck: {info['fingerabdruck'] or 'unbekannt'}")
    print("Den privaten Schlüssel zeigt: clawbook key show --private")
    return 0


def replace_authorized_key(old_public, new_public):
    """Removes the old public key from authorized_keys, adds the new one."""
    ssh_dir = os.path.dirname(key_path())
    auth = os.path.join(ssh_dir, "authorized_keys")
    lines = []
    if os.path.isfile(auth):
        with open(auth, encoding="utf-8") as f:
            lines = f.read().splitlines()
    old_blob = old_public.split()[1] if old_public and len(old_public.split()) > 1 else None
    kept = [ln for ln in lines
            if not (old_blob and len(ln.split()) > 1 and old_blob in ln.split())]
    if new_public not in kept:
        kept.append(new_public)
    write_user_file(auth, "\n".join(kept) + "\n", mode=0o600)


def cmd_key_new(opts):
    key = key_path()
    if not opts["yes"]:
        if opts["json"] or not sys.stdin.isatty():
            raise CliError("Ein neues Schlüsselpaar braucht eine Bestätigung: "
                           "clawbook key new --yes", code=2)
        print("Ein neues Schlüsselpaar ersetzt das alte. Mit dem alten privaten")
        print("Schlüssel kommst du danach nicht mehr per SSH herein; den neuen")
        print("musst du unter Windows hinterlegen (z. B. über das Windows-Skript).")
        print("Auch GitHub kennt dann nur den alten Schlüssel: Git über SSH klappt")
        print("erst wieder, wenn du den neuen dort hinterlegst (Hinweis folgt).")
        if not ask_yes("Neues Schlüsselpaar erzeugen?"):
            print("Abgebrochen, der alte Schlüssel bleibt.")
            return 1
    old_public = None
    if os.path.isfile(key + ".pub"):
        with open(key + ".pub", encoding="utf-8") as f:
            old_public = f.read().strip()
    ssh_dir = os.path.dirname(key)
    if not os.path.isdir(ssh_dir):
        os.makedirs(ssh_dir, mode=0o700)
        chown_to_user(ssh_dir)
    tmpdir = tempfile.mkdtemp(dir=ssh_dir, prefix=".newkey-")
    try:
        tmpkey = os.path.join(tmpdir, "id_ed25519")
        rc, out = run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "",
                       "-C", f"{USER_NAME}@clawbook", "-f", tmpkey])
        if rc != 0:
            raise CliError(f"ssh-keygen ist fehlgeschlagen: {out.strip()}")
        for suffix in ("", ".pub"):
            chown_to_user(tmpkey + suffix)
            os.replace(tmpkey + suffix, key + suffix)
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)
    with open(key + ".pub", encoding="utf-8") as f:
        new_public = f.read().strip()
    replace_authorized_key(old_public, new_public)
    info = key_info()
    if opts["json"]:
        sys.stdout.write(dump_json(dict(info, neu=True)))
        return 0
    print("Neues Schlüsselpaar erzeugt; authorized_keys ist angepasst.")
    print(f"Fingerabdruck: {info['fingerabdruck'] or 'unbekannt'}")
    print("Den privaten Schlüssel für Windows zeigt: clawbook key show --private")
    print("Neuen Schlüssel bei GitHub hinterlegen (nur nötig, wenn du bei GitHub")
    print("angemeldet bist; sonst erledigt das die GitHub-Anmeldung im Menü):")
    print("  gh auth refresh -s admin:public_key")
    print("  gh ssh-key add ~/.ssh/id_ed25519.pub --title clawbook")
    print("Den alten Eintrag löschst du unter https://github.com/settings/keys")
    return 0


# --- apt -------------------------------------------------------------------
# Technology packages (clawbook-*) and courses (kurs-*) come from the signed
# source clawbook-apt (/etc/apt/sources.list.d/clawbook.sources). apt keeps
# downloads and package lists in the home volume (~/.clawbook/apt).

def now_text():
    return (datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)
            .isoformat().replace("+00:00", "Z"))


def read_json(path):
    with open(path, encoding="utf-8-sig") as f:
        return json.load(f)


def apt_dir():
    return os.path.join(state_dir(), APT_STATE)


def dir_size(path):
    """Bytes of all files below path (unreadable parts are skipped)."""
    total = 0
    for root, _dirs, files in os.walk(path, onerror=lambda e: None):
        for name in files:
            try:
                total += os.lstat(os.path.join(root, name)).st_size
            except OSError:
                pass
    return total


def as_root(cmd):
    if os.geteuid() == 0:
        return cmd
    return ["sudo", "-n"] + cmd


def apt_get(args, c_locale=False):
    """apt-get as root, without debconf questions, waiting for apt locks.
    c_locale: English messages (parsed by clawbook, stable in the log)."""
    env = ["DEBIAN_FRONTEND=noninteractive"] + (["LC_ALL=C.UTF-8"] if c_locale else [])
    return as_root(["env"] + env + ["apt-get"] + APT_LOCK + args)


def apt_update_problem(rc, out):
    """German message when "apt-get update" did not reach every source."""
    bad = [ln.strip() for ln in out.splitlines()
           if ln.startswith(("Err:", "E:"))
           or (ln.startswith("W:") and ("Failed to fetch" in ln or "index files" in ln))]
    if rc == 0 and not bad:
        return None
    if re.search(r"Temporary failure resolving|Could not resolve|Network is unreachable|"
                 r"Could not connect|Connection timed out|No route to host", out):
        return ("Keine Verbindung zum Internet: Die Paketquellen sind nicht erreichbar. "
                "clawbook arbeitet mit den zuletzt geladenen Paketlisten.")
    if re.search(r"Could not get lock|Unable to lock", out):
        return "Die Paketverwaltung ist gerade belegt (läuft eine Installation?)."
    if "sudo" in out and rc != 0:
        return f"apt-get update braucht root-Rechte: {out.strip().splitlines()[-1]}"
    detail = bad[0] if bad else (out.strip().splitlines() or ["unbekannter Fehler"])[-1]
    return f"Die Paketquellen ließen sich nicht aktualisieren: {detail}"


def apt_update():
    """Refreshes the package lists. Returns (problem or None, apt output)."""
    rc, out = run(apt_get(["-q", "update"], c_locale=True), timeout=900)
    return apt_update_problem(rc, out), out


def catalog_packages():
    """Packages of clawbook-apt known to apt (only those with the field
    X-Clawbook-Art): [{name, art, version, beschreibung}]."""
    env = {"LC_ALL": "C.UTF-8"}
    _, out = run(["apt-cache", "search", "--names-only", r"^(clawbook|kurs)-"],
                 timeout=120, env=env)
    names = sorted({ln.split(" - ", 1)[0].strip() for ln in out.splitlines() if " - " in ln})
    names = [n for n in names if PACKAGE_RE.match(n)]
    if not names:
        return []
    _, out = run(["apt-cache", "show", "--no-all-versions"] + names, timeout=120, env=env)
    result = []
    for stanza in out.split("\n\n"):
        fields = {}
        for line in stanza.splitlines():
            if line[:1] not in (" ", "\t") and ":" in line:
                key, value = line.split(":", 1)
                fields[key.strip().lower()] = value.strip()
        name, art = fields.get("package"), fields.get("x-clawbook-art")
        if not name or not art or any(p["name"] == name for p in result):
            continue
        result.append({"name": name, "art": art, "version": fields.get("version"),
                       "beschreibung": fields.get("description", "")})
    return result


def installed_packages():
    """Installed clawbook-* and kurs-* packages from dpkg."""
    fmt = "${Package}\t${Version}\t${db:Status-Abbrev}\t${X-Clawbook-Art}\n"
    _, out = run(["dpkg-query", "-W", "-f=" + fmt, "clawbook-*", "kurs-*"])
    # dpkg-query exits 1 when a pattern matches nothing; the output still counts.
    packages = []
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) < 3 or not parts[2].startswith("ii"):
            continue
        art = parts[3].strip() if len(parts) > 3 else ""
        if not art:
            art = "kurs" if parts[0].startswith("kurs-") else "technik"
        packages.append({"name": parts[0], "version": parts[1], "art": art})
    return sorted(packages, key=lambda p: p["name"])


def manual_packages():
    """Packages installed on purpose (not only as a dependency)."""
    _, out = run(["apt-mark", "showmanual"], timeout=60)
    return set(out.split())


def collect_catalog(update=True):
    problem = apt_update()[0] if update else None
    packages = catalog_packages()
    if not packages:
        raise CliError(problem or "Die Paketquelle clawbook-apt kennt noch keine Pakete; "
                                  "aktualisieren mit: clawbook pakete katalog")
    installed = {p["name"]: p["version"] for p in installed_packages()}
    for p in packages:
        p["installiert"] = p["name"] in installed
        p["installierte_version"] = installed.get(p["name"])
    packages.sort(key=lambda p: (p["art"] != "kurs", p["name"]))
    return {"aktualisiert": update and problem is None, "warnung": problem, "pakete": packages}


def vscode_extensions():
    """Container extensions from /usr/share/clawbook/vscode-extensions.d/*.list
    (one list per installed technology package)."""
    result = []
    try:
        names = sorted(n for n in os.listdir(VSCODE_LISTS_DIR) if n.endswith(".list"))
    except OSError:
        return result
    for name in names:
        try:
            with open(os.path.join(VSCODE_LISTS_DIR, name), encoding="utf-8") as f:
                for line in f:
                    ext = line.split("#", 1)[0].strip()
                    if ext and ext not in result:
                        result.append(ext)
        except OSError:
            continue
    return result


# --- kurse -----------------------------------------------------------------

def read_course(kennung):
    if not COURSE_ID_RE.match(kennung):
        raise CliError(f"„{kennung}“ ist keine gültige Kennung "
                       "(Kleinbuchstaben, Ziffern, Bindestrich).", code=2)
    path = os.path.join(KURSE_DIR, kennung, "vscode.json")
    try:
        data = read_json(path)
    except FileNotFoundError:
        raise CliError(f"Für „{kennung}“ gibt es keine Kursbeschreibung ({path}); "
                       "installierte Kurse zeigt: clawbook kurse")
    except (OSError, ValueError) as e:
        raise CliError(f"Die Kursbeschreibung {path} ist fehlerhaft: {e}")
    if not isinstance(data, dict):
        raise CliError(f"Die Kursbeschreibung {path} ist fehlerhaft: kein JSON-Objekt")
    return data


def installed_courses(packages=None):
    """Installed courses [{kennung, titel, version}]: every course package
    brings /usr/share/clawbook/kurse/<kennung>/vscode.json. The built-in
    "clawbook" (no course) is not listed."""
    if packages is None:
        packages = installed_packages()
    versions = {p["name"]: p["version"] for p in packages}
    result = []
    for path in sorted(glob.glob(os.path.join(KURSE_DIR, "*", "vscode.json"))):
        kennung = os.path.basename(os.path.dirname(path))
        if kennung == DEFAULT_COURSE or not COURSE_ID_RE.match(kennung):
            continue
        try:
            data = read_json(path)
        except (OSError, ValueError):
            data = {}
        titel = data.get("titel") if isinstance(data, dict) else None
        result.append({"kennung": kennung, "titel": titel or kennung,
                       "version": versions.get(kennung)})
    return result


def union(*lists):
    result = []
    for items in lists:
        for item in items or []:
            if isinstance(item, str) and item not in result:
                result.append(item)
    return result


def merged_course(kennung):
    """Course description for the VSCodePack of a course, format 1.

    Windows extensions: built-in pack + course. Container extensions:
    built-in pack + the lists of ALL installed technology packages + course
    additions. Settings: built-in pack, course wins. All packs connect to
    the same container and share its VS Code server, so every pack gets
    the extensions for every installed tool (also for single technology
    packages installed by hand). For "clawbook": the built-in pack plus all
    technology packages."""
    base = read_course(DEFAULT_COURSE)
    course = base if kennung == DEFAULT_COURSE else read_course(kennung)

    def part(data, key):
        value = data.get(key)
        return value if isinstance(value, dict) else {}

    result = dict(course)
    result["windows"] = dict(part(course, "windows"), erweiterungen=union(
        part(base, "windows").get("erweiterungen"), part(course, "windows").get("erweiterungen")))
    result["container"] = dict(part(course, "container"), erweiterungen=union(
        part(base, "container").get("erweiterungen"), vscode_extensions(),
        part(course, "container").get("erweiterungen")))
    settings = dict(part(base, "einstellungen"))
    settings.update(part(course, "einstellungen"))
    result["einstellungen"] = settings
    return result


def cmd_kurs(opts, args):
    if len(args) != 2 or args[0] != "vscode":
        raise CliError("Aufruf: clawbook kurs vscode <kennung> [--json]", code=2)
    kennung = args[1]
    data = merged_course(kennung)
    if opts["json"]:
        sys.stdout.write(dump_json(data))
        return 0
    print(f"Kurs {data.get('kennung', kennung)}: {data.get('titel', '')}")
    print(f"  Format:   {data.get('format')}")
    print(f"  Ordner:   {data.get('ordner', '')}")
    for link in data.get("links") or []:
        print(f"  Link:     {link.get('titel', '')} - {link.get('url', '')}")
    win = data["windows"]["erweiterungen"]
    cont = data["container"]["erweiterungen"]
    print(f"  VS Code unter Windows:   {', '.join(win) if win else 'keine'}")
    print(f"  VS Code im Container:    {', '.join(cont) if cont else 'keine'}")
    return 0


def cmd_kurse(opts):
    courses = installed_courses()
    if opts["json"]:
        sys.stdout.write(dump_json({"kurse": courses}))
        return 0
    if not courses:
        print("Es ist kein Kurs installiert (Kurse hinzufügen: clawbook, Menü 6).")
        return 0
    print("Installierte Kurse:")
    for c in courses:
        print(f"  {c['kennung']:<14} {c['titel']}  ({c['version'] or 'Version unbekannt'})")
    return 0


# --- stand -----------------------------------------------------------------

def stand_path():
    return os.path.join(state_dir(), "stand.json")


def collect_stand():
    build = read_build()
    packages = installed_packages()
    manual = manual_packages()
    for p in packages:
        p["manuell"] = p["name"] in manual
    names = {p["name"] for p in packages}
    # Not yet restored after a new image: keep them in the state, so that a
    # "stand --write" in between does not lose them.
    restore = restore_state()
    pending = []
    if restore["zustand"] in ("laeuft", "fehler"):
        pending = [n for n in restore.get("pakete") or [] if n not in names]
    return {
        "format": STAND_FORMAT,
        "schnittstelle": SCHNITTSTELLE,
        "datum": now_text(),
        "build": {"commit": build.get("commit"), "erstellt": build.get("built")},
        "image": image_version(build),
        "kurse": [c["kennung"] for c in installed_courses(packages)],
        "pakete": packages,
        "ausstehend": pending,
        "vscode": {"container": {"erweiterungen": vscode_extensions()}},
    }


def write_stand():
    s = collect_stand()
    write_user_file(stand_path(), dump_json(s))
    return s


def cmd_stand(opts):
    s = write_stand() if opts["write"] else collect_stand()
    if opts["json"]:
        sys.stdout.write(dump_json(s))
        return 0
    print("clawbook - Stand")
    print(f"  Datum:          {s['datum']}")
    print(f"  Build:          {s['build']['commit'] or 'unbekannt'}")
    print(f"  Image-Version:  {s['image'] or 'unbekannt'}")
    print(f"  Kurse:          {', '.join(s['kurse']) if s['kurse'] else 'keine'}")
    if s["pakete"]:
        print("  Pakete:")
        for p in s["pakete"]:
            how = "" if p["manuell"] else ", als Abhängigkeit"
            print(f"    {p['name']:<24} {p['version']}  ({p['art']}{how})")
    else:
        print("  Pakete:         keine")
    if s["ausstehend"]:
        print(f"  Noch nicht wiederhergestellt: {', '.join(s['ausstehend'])}")
    exts = s["vscode"]["container"]["erweiterungen"]
    print(f"  VS Code im Container: {', '.join(exts) if exts else 'keine Erweiterungen'}")
    if opts["write"]:
        print(f"Gespeichert in {stand_path()}")
    return 0


# --- pakete ----------------------------------------------------------------

def say(opts, text=""):
    """Progress text: on stderr for --json (stdout carries only JSON)."""
    print(text, file=sys.stderr if opts["json"] else sys.stdout, flush=True)


def stream(cmd, opts, env=None):
    """Runs a command with its output visible (stderr for --json). Asks on
    the terminal only without --yes/--json. Returns the exit code."""
    target = sys.stderr if opts["json"] else None
    interactive_run = not opts["json"] and not opts["yes"] and is_terminal()
    sys.stdout.flush()
    sys.stderr.flush()
    try:
        return subprocess.run(cmd, stdin=None if interactive_run else subprocess.DEVNULL,
                              stdout=target, stderr=target, check=False,
                              env=dict(os.environ, **env) if env else None).returncode
    except OSError as e:
        raise CliError(f"{cmd[0]} ließ sich nicht starten: {e}")


def check_names(names, verb):
    if not names:
        raise CliError(f"Aufruf: clawbook pakete {verb} <name...> [--yes] [--json]", code=2)
    for name in names:
        if not PACKAGE_RE.match(name):
            raise CliError(f"„{name}“ ist kein Paket von clawbook "
                           "(Namen beginnen mit clawbook- oder kurs-).", code=2)


def need_confirmation(opts, verb):
    if not opts["yes"] and (opts["json"] or not is_terminal()):
        raise CliError(f"Ohne Terminal braucht „clawbook pakete {verb}“ die Bestätigung --yes.",
                       code=2)


def restore_hint(opts):
    if restore_summary()["zustand"] == "laeuft":
        say(opts, "Hinweis: Die Wiederherstellung der Pakete läuft noch. Die Installation "
                  "wartet, bis sie fertig ist; die Paketlisten werden dabei vielleicht nicht "
                  "aktualisiert.")


def wait_for_restore(opts):
    """Waits until a running restore has ended (at most one hour)."""
    deadline = time.time() + 3600
    told = False
    while restore_summary()["zustand"] == "laeuft" and time.time() < deadline:
        if not told:
            say(opts, "Die Wiederherstellung der Pakete läuft noch; clawbook wartet, bis sie "
                      f"fertig ist (Fortschritt: {restore_log_path()}) ...")
            told = True
        time.sleep(5)


def cmd_pakete_katalog(opts):
    if not opts["json"]:
        print("Paketquellen werden aktualisiert ...", flush=True)
    cat = collect_catalog()
    if opts["json"]:
        sys.stdout.write(dump_json(cat))
        return 0
    if cat["warnung"]:
        print(f"Warnung: {cat['warnung']}")
    for art, heading in (("kurs", "Kurse"), ("technik", "Technikpakete")):
        items = [p for p in cat["pakete"] if p["art"] == art]
        if not items:
            continue
        print(f"{heading}:")
        for p in items:
            mark = "installiert" if p["installiert"] else "-"
            print(f"  {p['name']:<22} {p['version'] or '':<10} {mark:<12} {p['beschreibung']}")
    print("Hinzufügen: clawbook pakete add <name>   Entfernen: clawbook pakete remove <name>")
    return 0


def cmd_pakete_add(opts, names):
    check_names(names, "add")
    need_confirmation(opts, "add")
    restore_hint(opts)
    say(opts, "Paketquellen werden aktualisiert ...")
    problem = apt_update()[0]
    if problem:
        say(opts, f"Warnung: {problem}")
    known = {p["name"] for p in catalog_packages()}
    unknown = [n for n in names if n not in known]
    if unknown:
        raise CliError("Nicht in der Paketquelle: " + ", ".join(unknown)
                       + (f" ({problem})" if problem else
                          " (alle Pakete zeigt: clawbook pakete katalog)"))
    rc = stream(apt_get(["install"] + (["-y"] if opts["yes"] else []) + names), opts)
    if rc != 0:
        raise CliError(f"Die Installation ist fehlgeschlagen oder wurde abgebrochen (apt-get {rc}).")
    restore_forget(names)
    write_stand()
    installed = {p["name"] for p in installed_packages()}
    result = {"aktion": "add", "pakete": names,
              "installiert": sorted(n for n in names if n in installed),
              "stand": stand_path(), "vorladen": preload_after_add(opts, installed)}
    if opts["json"]:
        sys.stdout.write(dump_json(result))
    else:
        print(f"Installiert: {', '.join(result['installiert'])}. Stand gespeichert in {stand_path()}.")
        courses = [n for n in names if n.startswith("kurs-")]
        if courses:
            print("Für VS Code unter Windows: Das passende VSCodePack richtet das Windows-Skript ein.")
    return 0


def simulated_removals(args):
    """Package names apt-get would remove (simulation, needs no root)."""
    _, out = run(["apt-get", "-s"] + args, timeout=300, env={"LC_ALL": "C.UTF-8"})
    return {m.group(1) for m in re.finditer(r"^Remv (\S+)", out, re.MULTILINE)}


def cmd_pakete_remove(opts, names):
    check_names(names, "remove")
    need_confirmation(opts, "remove")
    # A package still pending in a running restore would be installed after
    # the removal: wait for the restore first, then remove as usual.
    if set(names) & set(restore_summary()["pakete"]):
        wait_for_restore(opts)
    restore_forget(names)
    installed = {p["name"] for p in installed_packages()}
    todo = [n for n in names if n in installed]
    missing = [n for n in names if n not in installed]
    if todo:
        # The packages plus the dependencies only they needed - but not the
        # packages of the image that were already orphaned before.
        orphans_before = simulated_removals(["autoremove"])
        targets = simulated_removals(["remove", "--autoremove"] + todo) - orphans_before
        targets = sorted(targets | set(todo))
        rc = stream(apt_get(["remove"] + (["-y"] if opts["yes"] else []) + targets), opts)
        if rc != 0:
            raise CliError(f"Das Entfernen ist fehlgeschlagen oder wurde abgebrochen "
                           f"(apt-get {rc}).")
    write_stand()
    after = {p["name"] for p in installed_packages()}
    result = {"aktion": "remove", "pakete": names,
              "entfernt": sorted(n for n in todo if n not in after),
              "nicht_installiert": missing, "stand": stand_path()}
    if opts["json"]:
        sys.stdout.write(dump_json(result))
    else:
        if result["entfernt"]:
            print(f"Entfernt: {', '.join(result['entfernt'])}. Stand gespeichert in {stand_path()}.")
        if missing:
            print(f"Nicht installiert: {', '.join(missing)}")
    return 0


# PlatformIO: the platform for ESP32 (pioarduino, Arduino core 3.x) with
# toolchain and framework takes about 6 GB in ~/.platformio (measured: the
# toolchains are kept twice, in packages/ and tools/). clawbook loads it
# once after the course by building a throwaway project, so
# that the first real build neither waits nor needs the network.

PIO_INTRO = """
PlatformIO für ESP32 vorladen
-----------------------------
Für den ersten Build braucht PlatformIO die ESP32-Plattform (pioarduino mit
Arduino-Framework) samt Compiler: etwa 6 GB, die in deinem Home landen
(~/.platformio). Das dauert je nach Verbindung 2 bis 20 Minuten. Machst du
es jetzt, geht später der erste Build schnell und auch ohne Internet."""

PIO_INI = """\
; Throwaway project of "clawbook pakete vorladen"
[env:esp32dev]
platform = {url}
board = esp32dev
framework = arduino
"""

PIO_MAIN = """\
#include <Arduino.h>

void setup() {}

void loop() {}
"""


def platformio_dir():
    return os.path.join(user_home(), ".platformio")


def platformio_ready():
    root = platformio_dir()
    return (bool(glob.glob(os.path.join(root, "platforms", "espressif32*")))
            and bool(glob.glob(os.path.join(root, "packages", "framework-arduinoespressif32*"))))


def preload_platformio(opts):
    pio = shutil.which("pio")
    if not pio:
        raise CliError("PlatformIO fehlt: zuerst clawbook pakete add clawbook-embedded "
                       "(oder kurs-iot).")
    say(opts, "PlatformIO lädt jetzt die ESP32-Plattform (etwa 6 GB) und baut ein "
              "Testprojekt. Bitte warten ...")
    start = time.time()
    tmp = tempfile.mkdtemp(prefix="clawbook-pio-")
    try:
        os.makedirs(os.path.join(tmp, "src"))
        with open(os.path.join(tmp, "platformio.ini"), "w", encoding="utf-8") as f:
            f.write(PIO_INI.format(url=PIO_PLATFORM_URL))
        with open(os.path.join(tmp, "src", "main.cpp"), "w", encoding="utf-8") as f:
            f.write(PIO_MAIN)
        for path in (tmp, os.path.join(tmp, "src"), os.path.join(tmp, "platformio.ini"),
                     os.path.join(tmp, "src", "main.cpp")):
            chown_to_user(path)
        rc = stream(as_user(["env", f"HOME={user_home()}", "PLATFORMIO_SETTING_ENABLE_TELEMETRY=No",
                             pio, "run", "-d", tmp]), dict(opts, yes=True))
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    seconds = int(time.time() - start)
    size = dir_size(platformio_dir())
    ok = rc == 0 and platformio_ready()
    if ok:
        say(opts, f"PlatformIO ist vorgeladen ({seconds // 60} min {seconds % 60} s); "
                  f"~/.platformio belegt {human_bytes(size)}.")
    else:
        say(opts, f"Das Vorladen hat nicht geklappt (pio {rc}). Später erneut: "
                  "clawbook pakete vorladen")
    return {"vorhanden": platformio_ready(), "ausgefuehrt": True, "ok": ok,
            "bytes": size, "dauer_s": seconds}


def preload_after_add(opts, installed):
    """After adding packages: PlatformIO for kurs-iot / clawbook-embedded.
    --vorladen does it, a terminal asks, otherwise only a hint."""
    if not installed & set(PIO_PACKAGES):
        return None
    if platformio_ready():
        return {"vorhanden": True, "ausgefuehrt": False, "ok": None, "bytes": None,
                "dauer_s": None}
    if opts["vorladen"]:
        return preload_platformio(opts)
    if not opts["json"] and not opts["yes"] and is_terminal():
        print(PIO_INTRO)
        if ask_yes("PlatformIO jetzt vorladen?"):
            return preload_platformio(opts)
    say(opts, "PlatformIO vorladen (etwa 6 GB) später mit: clawbook pakete vorladen")
    return {"vorhanden": False, "ausgefuehrt": False, "ok": None, "bytes": None, "dauer_s": None}


def cmd_pakete_vorladen(opts):
    if platformio_ready():
        result = {"vorhanden": True, "ausgefuehrt": False, "ok": True,
                  "bytes": dir_size(platformio_dir()), "dauer_s": None}
        say(opts, f"PlatformIO ist schon vorgeladen (~/.platformio belegt "
                  f"{human_bytes(result['bytes'])}).")
    else:
        if not opts["json"] and is_terminal():
            print(PIO_INTRO)
        result = preload_platformio(opts)
    if opts["json"]:
        sys.stdout.write(dump_json(result))
    return 0 if result["ok"] else 1


def cmd_pakete(opts, args):
    usage = ("Aufruf: clawbook pakete katalog | add <name...> | remove <name...> | vorladen "
             "[--yes] [--vorladen] [--json]")
    if not args:
        if opts["json"] or not is_terminal():
            raise CliError(usage, code=2)
        menu_pakete()
        return 0
    sub, rest = args[0], args[1:]
    if sub == "katalog" and not rest:
        return cmd_pakete_katalog(opts)
    if sub == "add":
        return cmd_pakete_add(opts, rest)
    if sub == "remove":
        return cmd_pakete_remove(opts, rest)
    if sub == "vorladen" and not rest:
        return cmd_pakete_vorladen(opts)
    raise CliError(usage, code=2)


# --- wiederherstellen ------------------------------------------------------
# Installed packages live in the container's writable layer and are gone
# after a new image. ~/.clawbook/stand.json (home volume) names them:
# cont-init.d/10-clawbook notes the missing ones ("--pruefen", fast), the
# s6 service clawbook-restore installs them in the background ("--dienst"),
# from the apt cache in the home volume where possible.

RESTORE_STATES = ("keine", "laeuft", "fertig", "fehler")


def restore_path():
    return os.path.join(state_dir(), RESTORE_JSON)


def restore_log_path():
    return os.path.join(state_dir(), RESTORE_LOG)


def restore_state():
    try:
        data = read_json(restore_path())
    except (OSError, ValueError):
        data = None
    if not isinstance(data, dict) or data.get("zustand") not in RESTORE_STATES:
        return {"zustand": "keine", "pakete": []}
    return data


def restore_save(state):
    write_user_file(restore_path(), dump_json(state))


def restore_summary():
    s = restore_state()
    summary = {"zustand": s["zustand"], "pakete": s.get("pakete") or [],
               "meldung": s.get("meldung"), "beginn": s.get("beginn"), "ende": s.get("ende"),
               "download": s.get("download"), "log": restore_log_path()}
    if s["zustand"] == "laeuft" and isinstance(s.get("pid"), int) and not restore_running(s):
        summary.update(zustand="fehler", meldung="Die Wiederherstellung wurde abgebrochen; "
                                                 "erneut versuchen: clawbook wiederherstellen")
    return summary


def restore_forget(names):
    """Packages added or removed by hand are no longer pending."""
    state = restore_state()
    pending = state.get("pakete") or []
    if state["zustand"] in ("laeuft", "fehler") and set(names) & set(pending):
        state["pakete"] = [n for n in pending if n not in names]
        if not state["pakete"] and state["zustand"] == "fehler":
            state["zustand"] = "fertig"
            state["meldung"] = None
        restore_save(state)


def stand_wanted():
    """Packages ~/.clawbook/stand.json asks for: those installed on purpose
    (dependencies follow) plus the ones still pending. Stand format 1 has
    no "manuell": then all of them."""
    try:
        data = read_json(stand_path())
    except (OSError, ValueError):
        return []
    if not isinstance(data, dict):
        return []
    wanted = []
    for p in data.get("pakete") or []:
        if isinstance(p, dict) and p.get("manuell", True):
            wanted.append(p.get("name"))
    wanted += data.get("ausstehend") or []
    return union([n for n in wanted if isinstance(n, str) and PACKAGE_RE.match(n)])


def restore_check():
    installed = {p["name"] for p in installed_packages()}
    missing = [n for n in stand_wanted() if n not in installed]
    state = {"zustand": "laeuft" if missing else "keine", "pakete": missing,
             "beginn": now_text() if missing else None, "ende": None, "meldung": None,
             "download": None}
    restore_save(state)
    return state


def restore_running(state):
    """True when another clawbook is restoring right now."""
    pid = state.get("pid")
    if state["zustand"] != "laeuft" or not isinstance(pid, int):
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def run_logged(cmd, log, echo):
    """Runs cmd, appends its output to log (and the terminal); returns
    (exit code, output)."""
    lines = []
    try:
        p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT)
    except OSError as e:
        log.write(f"{cmd[0]}: {e}\n")
        return 127, str(e)
    for raw in p.stdout:
        line = raw.decode("utf-8", "replace")
        lines.append(line)
        log.write(line)
        log.flush()
        if echo:
            sys.stdout.write(line)
            sys.stdout.flush()
    return p.wait(), "".join(lines)


def deb_fields(path):
    rc, out = run(["dpkg-deb", "-f", path, "Package", "Version", "Depends", "Pre-Depends",
                   "Provides"])
    fields = {}
    if rc != 0:
        return fields
    key = None
    for line in out.splitlines():
        if line[:1] in (" ", "\t") and key:
            fields[key] += " " + line.strip()
        elif ":" in line:
            key, value = line.split(":", 1)
            key = key.strip().lower()
            fields[key] = value.strip()
    return fields


def cached_debs_for(packages):
    """Without package lists (offline, lists gone): the .deb files in the
    apt cache that the packages need - the packages themselves and every
    dependency that is not installed, following Depends/Pre-Depends.
    Returns (files, names, unresolved)."""
    archive = os.path.join(apt_dir(), "archives")
    newest = {}
    for path in glob.glob(os.path.join(archive, "*.deb")):
        f = deb_fields(path)
        name, version = f.get("package"), f.get("version")
        if not name or not version:
            continue
        old = newest.get(name)
        if old:
            rc, _ = run(["dpkg", "--compare-versions", version, "gt", old[1]])
            if rc != 0:
                continue
        newest[name] = (path, version, f)
    provided = {}
    for name, (_path, _version, f) in newest.items():
        for prov in (f.get("provides") or "").split(","):
            prov = prov.split("(")[0].strip()
            if prov:
                provided.setdefault(prov, name)
    _, out = run(["dpkg-query", "-W", "-f=${Package}\t${db:Status-Abbrev}\t${Provides}\n"])
    present = set()
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) >= 2 and parts[1].startswith("ii"):
            present.add(parts[0].split(":")[0])
            for prov in (parts[2] if len(parts) > 2 else "").split(","):
                if prov.strip():
                    present.add(prov.split("(")[0].strip())
    chosen, unresolved, todo = [], [], list(packages)
    while todo:
        name = todo.pop(0)
        if name in chosen or name in present:
            continue
        name = name if name in newest else provided.get(name, name)
        if name in chosen or name in present:
            continue
        if name not in newest:
            unresolved.append(name)
            continue
        chosen.append(name)
        f = newest[name][2]
        deps = ",".join(x for x in (f.get("pre-depends"), f.get("depends")) if x)
        for group in deps.split(","):
            alts = [a.split("(")[0].split(":")[0].strip() for a in group.split("|")]
            alts = [a for a in alts if a]
            if not alts or any(a in present or a in chosen for a in alts):
                continue
            todo.append(next((a for a in alts if a in newest or a in provided), alts[0]))
    return [newest[n][0] for n in chosen], chosen, unresolved


def restore_run(packages, echo=False):
    state = {"zustand": "laeuft", "pakete": packages, "beginn": now_text(), "ende": None,
             "meldung": None, "download": None, "pid": os.getpid()}
    restore_save(state)
    log_path = restore_log_path()
    write_user_file(log_path, "")
    try:
        with open(log_path, "a", encoding="utf-8") as log:
            restore_steps(state, packages, log, echo)
    except BaseException as e:
        # Never leave "laeuft" behind (status would wait forever).
        state.update(zustand="fehler", meldung=f"Die Wiederherstellung brach ab: {e!r}. "
                                               "Erneut: clawbook wiederherstellen")
        state["ende"] = now_text()
        state.pop("pid", None)
        restore_save(state)
        raise
    state["ende"] = now_text()
    state.pop("pid", None)
    with open(log_path, "a", encoding="utf-8") as log:
        log.write(f"{state['ende']} Ergebnis: {state['zustand']}"
                  + (f" - {state['meldung']}" if state["meldung"] else "")
                  + (f" (Download {state['download']})" if state["download"] else "") + "\n")
    if echo:
        print(f"Ergebnis: {state['zustand']}")
    restore_save(state)
    write_stand()
    return state


def restore_steps(state, packages, log, echo):
    def note(text):
        log.write(text + "\n")
        log.flush()
        if echo:
            print(text, flush=True)

    note(f"{now_text()} Wiederherstellung: {' '.join(packages)}")
    # An earlier run may have been stopped in the middle of dpkg.
    note("--- dpkg --configure -a")
    run_logged(as_root(["env", "DEBIAN_FRONTEND=noninteractive", "dpkg", "--configure", "-a"]),
               log, echo)
    note("--- apt-get update")
    rc, out = run_logged(apt_get(["-q", "update"], c_locale=True), log, echo)
    problem = apt_update_problem(rc, out)
    if problem:
        note(f"Hinweis: {problem}")
    known = {p["name"] for p in catalog_packages()}
    unavailable = [n for n in packages if n not in known]
    available = [n for n in packages if n in known]
    rc = 0
    if available:
        note("--- apt-get install " + " ".join(available))
        rc, out = run_logged(apt_get(["-q", "-y", "install"] + available, c_locale=True),
                             log, echo)
        m = re.search(r"Need to get (\S+ \S+?)(?:/\S+ \S+)? of archives", out)
        state["download"] = m.group(1) if m else ("0 B" if rc == 0 else None)
    if unavailable and problem:
        # No network and the package lists do not know them (e.g. lists
        # gone): install straight from the .deb files in the apt cache.
        files, names, unresolved = cached_debs_for(unavailable)
        note(f"--- ohne Paketlisten aus dem Cache: {' '.join(names) or '-'}")
        if files and not unresolved:
            rc2, _ = run_logged(apt_get(["-q", "-y", "install"] + files, c_locale=True),
                                log, echo)
            if rc2 == 0:
                deps = [n for n in names if n not in unavailable]
                if deps:
                    run_logged(as_root(["apt-mark", "auto"] + deps), log, echo)
                unavailable = []
                state["download"] = state["download"] or "0 B"
            rc = rc or rc2
        elif unresolved:
            note("Nicht im Cache: " + ", ".join(unresolved))
    if rc == 0 and not unavailable:
        state.update(zustand="fertig", meldung=None)
    elif rc == 0:
        state.update(zustand="fehler", meldung=(
            "Kein Netz, und im Paket-Cache fehlt etwas für: " if problem
            else "Nicht in der Paketquelle: ") + ", ".join(unavailable))
    else:
        reason = (" Ohne Internet gelingt das nur, wenn alle Pakete im Cache liegen."
                  if problem else "")
        state.update(zustand="fehler",
                     meldung=f"apt-get install ist fehlgeschlagen ({rc}).{reason} "
                             f"Details: {restore_log_path()}")


def cmd_wiederherstellen(opts):
    if opts["pruefen"]:
        state = restore_check()
        if state["zustand"] == "laeuft":
            print(f"Wiederherstellung: {', '.join(state['pakete'])} fehlen in diesem Image; "
                  "sie werden im Hintergrund eingespielt (clawbook status, "
                  f"{restore_log_path()}).")
        return 0
    if opts["dienst"]:
        state = restore_state()
        names = union([n for n in state.get("pakete") or []
                       if isinstance(n, str) and PACKAGE_RE.match(n)])
        if state["zustand"] != "laeuft" or not names:
            return 0
        state = restore_run(names)
        print(f"Wiederherstellung: {state['zustand']}"
              + (f" - {state['meldung']}" if state.get("meldung") else ""))
        return 0 if state["zustand"] == "fertig" else 1
    state = restore_state()
    if restore_running(state):
        raise CliError("Die Wiederherstellung läuft schon im Hintergrund "
                       f"(Fortschritt: {restore_log_path()}).")
    state = restore_check()
    if state["zustand"] == "laeuft":
        state = restore_run(state["pakete"], echo=not opts["json"])
    if opts["json"]:
        sys.stdout.write(dump_json(restore_summary()))
    elif state["zustand"] == "keine":
        print("Nichts wiederherzustellen: Alle Pakete aus dem Stand sind installiert.")
    else:
        print(f"Wiederherstellung: {state['zustand']}"
              + (f" - {state['meldung']}" if state.get("meldung") else ""))
    return 0 if state["zustand"] in ("keine", "fertig") else 1


# --- github ----------------------------------------------------------------
# gh keeps its login in the home of "student" (~/.config/gh). When clawbook
# runs as root (docker exec / wslc exec), gh is called as "student".

def as_user(cmd):
    if os.geteuid() == 0:
        return ["runuser", "-u", USER_NAME, "--"] + cmd
    return cmd


def is_terminal():
    return sys.stdin.isatty() and sys.stdout.isatty()


def in_vscode():
    return (os.environ.get("TERM_PROGRAM") == "vscode"
            or any(k.startswith("VSCODE_") for k in os.environ))


def github_state():
    """{"angemeldet": bool, "benutzer": str|None, "geprueft": bool}.

    Never prompts. "geprueft" is False when a token is stored but GitHub
    could not be asked (e.g. offline) - then it counts as logged in, so an
    offline login does not nag with a new GitHub login."""
    state = {"angemeldet": False, "benutzer": None, "geprueft": True}
    if not shutil.which("gh"):
        return state
    rc, out = run(as_user(["gh", "auth", "status", "--hostname", GH_HOST]), timeout=20)
    if rc == 0:
        m = re.search(r"account\s+(\S+)", out) or re.search(r"\bas\s+(\S+)", out)
        state.update(angemeldet=True, benutzer=m.group(1) if m else None)
        return state
    token_rc, _ = run(as_user(["gh", "auth", "token", "--hostname", GH_HOST]), timeout=10)
    if token_rc == 0 and not re.search(r"invalid|expired|revoked|401", out, re.IGNORECASE):
        state.update(angemeldet=True, geprueft=False)
    return state


def github_known_hosts():
    """Adds GitHub's SSH host keys (from the authenticated API) to
    ~/.ssh/known_hosts, so the first git over SSH does not ask about them."""
    rc, out = run(as_user(["gh", "api", "meta", "--jq", ".ssh_keys[]"]), timeout=30)
    keys = [k.strip() for k in out.splitlines() if k.strip().startswith(("ssh-", "ecdsa-"))]
    if rc != 0 or not keys:
        return
    path = os.path.join(user_home(), ".ssh", "known_hosts")
    lines = []
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    missing = [f"{GH_HOST} {k}" for k in keys if f"{GH_HOST} {k}" not in lines]
    if missing:
        write_user_file(path, "\n".join(lines + missing) + "\n", mode=0o644)


def github_ssh_ok():
    """True when GitHub accepts the container's SSH key."""
    _, out = run(as_user(["ssh", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
                          "git@" + GH_HOST]), timeout=30)
    return "successfully authenticated" in out


GITHUB_INTRO = """
GitHub-Anmeldung
----------------
Du bist in clawbook noch nicht bei GitHub angemeldet. Die Anmeldung brauchst
du für Git: Damit holst du Kurs-Repositorys und lädst deine Arbeit hoch.
Der WorkspaceManager (wsm) übernimmt deinen GitHub-Namen aus dieser Anmeldung.

So läuft es ab (gh fragt auf Englisch):
  - „Upload your SSH public key to your GitHub account?“
    → wähle /home/student/.ssh/id_ed25519.pub
  - „Title for your SSH key“ → Enter genügt
  - gh zeigt einen Code wie ABCD-1234. Drücke Enter, öffne dann
    https://github.com/login/device im Browser unter Windows,
    melde dich bei GitHub an und gib den Code ein.
"""

GITHUB_SSH_HINT = """\
Hinweis: GitHub kennt den SSH-Schlüssel dieses Containers noch nicht. Git über
SSH (so arbeitet wsm) klappt erst danach. Hinterlegen mit:
  gh auth refresh -s admin:public_key
  gh ssh-key add ~/.ssh/id_ed25519.pub --title clawbook"""


def github_login():
    """Runs the gh login (device code in the browser). True when logged in."""
    env = dict(os.environ)
    if not in_vscode():
        # No browser reachable from an SSH terminal (a browser in the RDP
        # session would stay unseen): gh only prints the address.
        env["GH_BROWSER"] = "echo Adresse für den Browser unter Windows:"
    cmd = as_user(["gh", "auth", "login", "--hostname", GH_HOST, "--git-protocol", "ssh",
                   "--web", "--insecure-storage"])
    print()
    try:
        rc = subprocess.run(cmd, env=env, check=False).returncode
    except KeyboardInterrupt:
        print("\nGitHub-Anmeldung abgebrochen.")
        return False
    except OSError as e:
        print(f"gh ließ sich nicht starten: {e}")
        return False
    state = github_state()
    if rc != 0 or not state["angemeldet"]:
        print("Die GitHub-Anmeldung hat nicht geklappt. Du kannst sie im Menü wiederholen.")
        return False
    run(as_user(["gh", "auth", "setup-git"]), timeout=30)
    github_known_hosts()
    print()
    print(f"Bei GitHub angemeldet als {state['benutzer'] or 'unbekannt'}.")
    if not github_ssh_ok():
        print(GITHUB_SSH_HINT)
    git_identity_offer()
    return True


def github_offer(for_wsm=False):
    """Explains the GitHub login and lets the student start or cancel it.
    True when gh is logged in afterwards."""
    print(GITHUB_INTRO)
    print("  1  Jetzt bei GitHub anmelden (empfohlen)")
    if for_wsm:
        print("  2  Abbrechen")
    else:
        print("  2  Abbrechen – weiter zum Menü (beim nächsten Start frage ich wieder)")
    while True:
        try:
            choice = input("Deine Wahl [1]: ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return False
        if choice in ("", "1"):
            return github_login()
        if choice in ("2", "0", "q", "x"):
            return False
        print("Bitte 1 oder 2 eingeben.")


def cmd_github(opts, args):
    if args == ["status"]:
        state = github_state()
        if opts["json"]:
            sys.stdout.write(dump_json(state))
            return 0 if state["angemeldet"] else 1
        github_show(state)
        return 0 if state["angemeldet"] else 1
    if args == ["identitaet"]:
        return cmd_github_identity(opts)
    if args == ["login"]:
        if opts["json"] or not is_terminal():
            raise CliError("Die GitHub-Anmeldung braucht ein Terminal: clawbook github login",
                           code=2)
        if opts["vor_wsm"]:
            return github_before_wsm()
        state = github_state()
        if state["angemeldet"]:
            github_show(state)
            return 0
        return 0 if github_offer() else 1
    raise CliError("Aufruf: clawbook github status [--json] | clawbook github login | "
                   "clawbook github identitaet [--yes] [--json]", code=2)


def github_show(state=None):
    """Menu item and "clawbook github status": what gh says."""
    if state is None:
        state = github_state()
    if not state["angemeldet"]:
        print("GitHub: nicht angemeldet. Anmelden mit: clawbook github login")
        return
    if not state["geprueft"]:
        print("GitHub: Anmeldung gespeichert, aber GitHub ist gerade nicht erreichbar.")
        return
    print(f"GitHub: angemeldet als {state['benutzer'] or 'unbekannt'}")
    print("  SSH-Schlüssel bei GitHub: "
          + ("hinterlegt" if github_ssh_ok() else "nicht hinterlegt"))
    _, out = run(as_user(["gh", "auth", "status", "--hostname", GH_HOST]), timeout=20)
    for line in out.splitlines():
        if line.strip():
            print("  " + line.rstrip())


def github_before_wsm():
    """Called by the wsm wrapper before wsm creates ~/.workspacemanager.yml.
    Exit code 0: go on with wsm, 1: stop."""
    if github_state()["angemeldet"]:
        return 0
    print()
    print("wsm (WorkspaceManager) richtet sich jetzt zum ersten Mal ein und")
    print("übernimmt dabei deinen GitHub-Namen. Melde dich deshalb zuerst bei GitHub an.")
    if github_offer(for_wsm=True):
        print()
        return 0
    print()
    print("Ohne GitHub-Anmeldung fragt wsm gleich nach deinem GitHub-Namen und trägt")
    print("ohne Eingabe „student“ in ~/.workspacemanager.yml ein. Das ist dann falsch")
    print("und muss später von Hand geändert werden.")
    if ask_yes("Trotzdem mit wsm fortfahren?"):
        return 0
    print("wsm nicht gestartet. Anmelden mit: clawbook github login")
    return 1


# --- git identity ----------------------------------------------------------
# After the GitHub login: user.name from the GitHub account (its login when
# no name is set) and the noreply address <id>+<login>@users.noreply.github.com,
# so a real e-mail address never ends up in public commits.

NOREPLY_DOMAIN = "users.noreply.github.com"


def github_user():
    """{"login", "id", "name"} of the logged-in GitHub account, or None."""
    if not shutil.which("gh"):
        return None
    rc, out = run_stdout(as_user(["gh", "api", "user"]), timeout=30)
    if rc != 0:
        return None
    try:
        data = json.loads(out)
    except ValueError:
        return None
    if (not isinstance(data, dict) or not isinstance(data.get("login"), str)
            or not data["login"] or not isinstance(data.get("id"), int)):
        return None
    return {"login": data["login"], "id": data["id"],
            "name": data["name"] if isinstance(data.get("name"), str) else ""}


def git_global(key):
    rc, out = run_stdout(as_user(["git", "config", "--global", "--get", key]), timeout=10)
    value = out.strip()
    return value if rc == 0 and value else None


def git_identity_plan(user, current_name, current_email):
    """What to do with the git identity. "aktion": "gleich" (already set
    like this), "setzen" (nothing set, or only matching parts) or
    "abweichend" (other values set; overwrite only on request)."""
    name = user["name"].strip() or user["login"]
    email = f"{user['id']}+{user['login']}@{NOREPLY_DOMAIN}"
    if current_name == name and current_email == email:
        aktion = "gleich"
    elif current_name not in (None, name) or current_email not in (None, email):
        aktion = "abweichend"
    else:
        aktion = "setzen"
    return {"name": name, "email": email, "github": user["login"],
            "bisher": {"name": current_name, "email": current_email}, "aktion": aktion}


def git_identity_collect():
    user = github_user()
    if user is None:
        raise CliError("GitHub kennt Ihr Konto gerade nicht: nicht angemeldet oder GitHub "
                       "nicht erreichbar (clawbook github status).")
    return git_identity_plan(user, git_global("user.name"), git_global("user.email"))


def git_identity_set(plan):
    for key, value in (("user.name", plan["name"]), ("user.email", plan["email"])):
        rc, out = run(as_user(["git", "config", "--global", key, value]), timeout=10)
        if rc != 0:
            raise CliError(f"git config --global {key} ist fehlgeschlagen: {out.strip()}")


def git_identity_offer(only_if_unset=False):
    """Interactive: shows the identity from GitHub and sets it after asking.
    only_if_unset: ask only when user.name or user.email is missing (menu
    check). Returns True when the identity was set."""
    try:
        plan = git_identity_collect()
    except CliError as e:
        print(f"Git-Identität: {e}")
        return False
    old = plan["bisher"]
    if plan["aktion"] == "gleich" or (only_if_unset and old["name"] and old["email"]):
        return False
    print()
    if plan["aktion"] == "setzen":
        print("Git trägt in jeden Commit einen Namen und eine E-Mail-Adresse ein.")
        print("Aus Ihrem GitHub-Konto:")
        print(f"  Name:   {plan['name']}")
        print(f"  E-Mail: {plan['email']}")
        print("  (die Noreply-Adresse von GitHub; Ihre echte E-Mail-Adresse bleibt privat)")
        agreed = ask_yes_default("Diese Angaben für Git übernehmen?")
    else:
        print("Git ist schon mit anderen Angaben eingerichtet:")
        print(f"  bisher:      {old['name'] or '(kein Name)'} <{old['email'] or 'keine E-Mail'}>")
        print(f"  aus GitHub:  {plan['name']} <{plan['email']}>")
        agreed = ask_yes("Die Angaben aus GitHub übernehmen?")
    if not agreed:
        print("Git-Identität unverändert. Von Hand ändern mit:")
        print('  git config --global user.name "Vorname Nachname"')
        print(f'  git config --global user.email "{plan["email"]}"')
        return False
    git_identity_set(plan)
    print(f"Git-Identität gesetzt: {plan['name']} <{plan['email']}>")
    return True


def cmd_github_identity(opts):
    """clawbook github identitaet: --json reports the plan (and never asks);
    --yes sets it without asking."""
    plan = git_identity_collect()
    if opts["yes"] and plan["aktion"] != "gleich":
        git_identity_set(plan)
        plan["gesetzt"] = True
        if not opts["json"]:
            print(f"Git-Identität gesetzt: {plan['name']} <{plan['email']}>")
    if opts["json"]:
        plan.setdefault("gesetzt", False)
        sys.stdout.write(dump_json(plan))
        return 0
    if opts["yes"]:
        return 0
    if plan["aktion"] == "gleich":
        print(f"Git-Identität passt schon: {plan['name']} <{plan['email']}>")
        return 0
    if not is_terminal():
        raise CliError("Die Rückfrage braucht ein Terminal: clawbook github identitaet "
                       "(oder --yes)", code=2)
    git_identity_offer()
    return 0


# --- wsm configuration -----------------------------------------------------
# wsm 1.0 wrote a configuration with a single location ~/source. wsm 1.1
# creates one with several locations below ~/source (github, samples,
# sandbox, ...), but only when the file is missing. clawbook renews an old
# one on request: the old file is kept as ~/.workspacemanager.yml.alt-<date>,
# then wsm's own function writes the default configuration (with stdin
# closed; the GitHub name comes from gh, name and e-mail from git config).
# Projects below ~/source are never touched.

def wsm_config_path():
    return os.path.join(user_home(), WSM_CONFIG)


def wsm_keep_path():
    return os.path.join(state_dir(), WSM_KEEP_FILE)


def wsm_config_outdated(path):
    """True for the configuration of wsm 1.0: exactly one "path:" entry,
    and it is ~/source. Line based (the image has no YAML module here)."""
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except (OSError, UnicodeDecodeError):
        return False
    paths = []
    for line in text.splitlines():
        if line.lstrip().startswith("#"):
            continue
        m = re.match(r"^\s*(?:-\s+)?path:\s*(.*?)\s*$", line)
        if m:
            value = m.group(1).split(" #", 1)[0].strip().strip("'\"").rstrip("/")
            paths.append(value)
    home = user_home()
    old = ("~/source", f"{home}/source", "$HOME/source", "${HOME}/source")
    return len(paths) == 1 and paths[0] in old


def wsm_state():
    path = wsm_config_path()
    return {"datei": path, "vorhanden": os.path.isfile(path),
            "veraltet": wsm_config_outdated(path),
            "nicht_mehr_fragen": os.path.exists(wsm_keep_path())}


def wsm_renew():
    """Backs up the old configuration and lets wsm write its default one.
    Returns the path of the backup."""
    gh = github_state()
    if not (gh["angemeldet"] and gh["geprueft"]):
        raise CliError("Für die neue wsm-Konfiguration braucht clawbook Ihre GitHub-Anmeldung "
                       "(wsm übernimmt Ihren GitHub-Namen). Erst anmelden: "
                       "clawbook github login")
    path = wsm_config_path()
    backup = f"{path}.alt-{datetime.date.today().isoformat()}"
    n = 2
    while os.path.exists(backup):
        backup = f"{path}.alt-{datetime.date.today().isoformat()}-{n}"
        n += 1
    os.rename(path, backup)
    rc, out = run(as_user([WSM_PYTHON, "-I", "-c", WSM_CREATE]), timeout=60)
    if rc != 0 or not os.path.isfile(path):
        if not os.path.exists(path):
            os.rename(backup, path)
        detail = out.strip().splitlines()[-1] if out.strip() else f"Exit-Code {rc}"
        raise CliError(f"wsm hat keine neue Konfiguration geschrieben ({detail}); "
                       "die alte Datei ist wieder an ihrem Platz.")
    return backup


WSM_OUTDATED = """
WorkspaceManager-Konfiguration
------------------------------
Ihre WorkspaceManager-Konfiguration (~/.workspacemanager.yml) ist veraltet:
Sie kennt nur den Ordner ~/source. Die neue Standard-Konfiguration teilt ihn in
Bereiche wie ~/source/github (eigene Projekte), ~/source/samples und
~/source/sandbox. Die alte Datei wird gesichert; Ihre Projekte unter ~/source
bleiben, wie sie sind."""


def wsm_offer(ask_again=False):
    """Interactive: offers to renew an outdated configuration. Without
    ask_again it stays quiet when the student said no before, when the
    configuration is fine and when GitHub is not available. Returns True
    when renewed."""
    st = wsm_state()
    if not st["veraltet"] or (st["nicht_mehr_fragen"] and not ask_again):
        return False
    gh = github_state()
    if not (gh["angemeldet"] and gh["geprueft"]) and not ask_again:
        return False
    print(WSM_OUTDATED)
    if not ask_yes_default("Konfiguration jetzt erneuern?"):
        write_user_file(wsm_keep_path(), "Alte wsm-Konfiguration behalten "
                                         "(erneuern: clawbook wsm erneuern).\n")
        print("Die alte Konfiguration bleibt; clawbook fragt nicht wieder.")
        print("Später erneuern mit: clawbook wsm erneuern")
        return False
    backup = wsm_renew()
    print("Neue Konfiguration angelegt: ~/.workspacemanager.yml")
    print(f"Die alte Datei liegt in {backup}.")
    return True


def cmd_wsm(opts, args):
    usage = "Aufruf: clawbook wsm status [--json] | clawbook wsm erneuern [--yes] [--json]"
    if args == ["status"]:
        st = wsm_state()
        if opts["json"]:
            sys.stdout.write(dump_json(st))
        elif not st["vorhanden"]:
            print("wsm hat noch keine Konfiguration; sie entsteht beim ersten Start von wsm.")
        elif st["veraltet"]:
            print("Die wsm-Konfiguration ist veraltet (nur ~/source). "
                  "Erneuern mit: clawbook wsm erneuern")
        else:
            print(f"Die wsm-Konfiguration ist aktuell ({st['datei']}).")
        return 0
    if args != ["erneuern"]:
        raise CliError(usage, code=2)
    if opts["vor_wsm"]:
        # From the wsm wrapper: ask at most once, never stop wsm.
        if is_terminal() and not opts["json"]:
            try:
                wsm_offer()
            except CliError as e:
                print(f"Hinweis: {e}")
        return 0
    st = wsm_state()
    if opts["yes"]:
        backup = wsm_renew() if st["veraltet"] else None
        if opts["json"]:
            sys.stdout.write(dump_json(dict(wsm_state(), erneuert=backup is not None,
                                            sicherung=backup)))
        elif backup:
            print(f"Neue Konfiguration angelegt; die alte Datei liegt in {backup}.")
        else:
            print("Nichts zu erneuern: Die wsm-Konfiguration fehlt oder ist aktuell.")
        return 0
    if opts["json"] or not is_terminal():
        raise CliError("Ohne Terminal braucht „clawbook wsm erneuern“ die Bestätigung --yes.",
                       code=2)
    if not st["veraltet"]:
        print("Nichts zu erneuern: Die wsm-Konfiguration fehlt oder ist aktuell.")
        return 0
    return 0 if wsm_offer(ask_again=True) else 1


# --- notebooklm ------------------------------------------------------------
# notebooklm-py keeps its Google login in ~/.notebooklm. "notebooklm auth
# check --json" checks it locally (file, cookies); with --test it also asks
# NotebookLM (network). Google moved NotebookLM to notebook.google.com, the
# CLI still reads the cookies of notebooklm.google.com: notebooklm-fix-cookies
# copies them over. clawbook knows three states: angemeldet, unvollstaendig
# (login present but not usable as it is) and nicht_angemeldet; "unbekannt"
# when notebooklm itself does not answer.

NLM_TEXT = {"angemeldet": "angemeldet", "unvollstaendig": "unvollständig",
            "nicht_angemeldet": "nicht angemeldet", "unbekannt": "unbekannt"}
NLM_CHECK_HINT = {"unvollstaendig": " (reparieren: clawbook notebooklm)",
                  "nicht_angemeldet": " (Anmeldung: clawbook notebooklm)",
                  "unbekannt": " (prüfen: clawbook notebooklm)"}
NLM_NETWORK_RE = re.compile(r"resolv|connect|network|timed? ?out|unreachable|name or service",
                            re.IGNORECASE)

NLM_LOGIN = """\
So melden Sie sich an:
  1. Unter Windows den Bildschirm des Containers öffnen (Remotedesktop),
     zum Beispiel in PowerShell: mstsc /v:localhost:3390
  2. Hier im Terminal eingeben: notebooklm login
  3. Im Chromium-Fenster auf dem Remotedesktop bei Google anmelden, bis
     NotebookLM geladen ist; dann den Hinweisen im Terminal folgen.
  4. Danach prüfen (und wenn nötig reparieren): clawbook notebooklm"""


def notebooklm_storage():
    for rel in NOTEBOOKLM_STORAGE:
        path = os.path.join(user_home(), rel)
        if os.path.isfile(path):
            return path
    return None


def notebooklm_repairable(path):
    """True when cookies of notebook.google.com are missing or different
    under notebooklm.google.com - exactly what notebooklm-fix-cookies fixes."""
    if not path:
        return False
    try:
        data = read_json(path)
    except PermissionError:
        rc, out = run_stdout(as_user(["cat", path]), timeout=10)
        try:
            data = json.loads(out) if rc == 0 else None
        except ValueError:
            data = None
    except (OSError, ValueError):
        data = None
    cookies = data.get("cookies") if isinstance(data, dict) else None
    if not isinstance(cookies, list):
        return False
    new = {c.get("name"): c.get("value") for c in cookies
           if isinstance(c, dict) and c.get("domain") == "notebook.google.com"}
    old = {c.get("name"): c.get("value") for c in cookies
           if isinstance(c, dict) and c.get("domain") == "notebooklm.google.com"}
    return any(old.get(name) != value for name, value in new.items())


def notebooklm_state(test=False):
    """Login state from "notebooklm auth check --json" (with --test also
    online). Never prompts."""
    state = {"zustand": "unbekannt", "konto": None, "reparierbar": False,
             "online_geprueft": False, "meldung": None, "datei": None}
    if not shutil.which("notebooklm"):
        state["meldung"] = "notebooklm ist nicht installiert."
        return state
    cmd = ["notebooklm", "auth", "check", "--json"] + (["--test"] if test else [])
    rc, out = run_stdout(as_user(cmd), timeout=90 if test else 30)
    try:
        data = json.loads(out)
    except ValueError:
        data = None
    if not isinstance(data, dict):
        state["meldung"] = f"notebooklm auth check antwortet nicht wie erwartet (Exit-Code {rc})."
        return state
    checks = data.get("checks") if isinstance(data.get("checks"), dict) else {}
    details = data.get("details") if isinstance(data.get("details"), dict) else {}
    account = data.get("account") or details.get("account")
    if isinstance(account, dict):
        account = account.get("email")
    state.update(konto=account if isinstance(account, str) else None,
                 meldung=details.get("error"),
                 datei=data.get("storage_path") or details.get("storage_path"))
    if not checks.get("storage_exists"):
        state["zustand"] = "nicht_angemeldet"
        return state
    state["reparierbar"] = notebooklm_repairable(notebooklm_storage())
    local_ok = bool(checks.get("json_valid") and checks.get("cookies_present")
                    and checks.get("sid_cookie"))
    fetched = checks.get("token_fetch")
    state["online_geprueft"] = fetched is True
    if rc == 0 and local_ok and (fetched is True or not state["reparierbar"]):
        state["zustand"] = "angemeldet"
    elif (local_ok and not state["reparierbar"] and fetched is False
          and NLM_NETWORK_RE.search(str(state["meldung"] or ""))):
        # Offline: the stored login looks fine, NotebookLM could not be asked.
        state["zustand"] = "angemeldet"
        state["meldung"] = "NotebookLM war nicht erreichbar (ohne Internet?): " + str(
            state["meldung"])
    else:
        state["zustand"] = "unvollstaendig"
    return state


def notebooklm_fix():
    """Runs notebooklm-fix-cookies as the student. Returns (ok, output)."""
    rc, out = run(as_user(["/usr/local/bin/notebooklm-fix-cookies"]), timeout=60)
    return rc == 0, out.strip()


def cmd_notebooklm(opts):
    state = notebooklm_state(test=True)
    if state["zustand"] == "unvollstaendig" and state["reparierbar"]:
        if not opts["json"]:
            print("NotebookLM: Die Anmeldung ist unvollständig. Google hat NotebookLM auf die")
            print("Adresse notebook.google.com umgezogen; das Werkzeug notebooklm sucht die")
            print("Anmeldedaten noch unter der alten Adresse. notebooklm-fix-cookies kopiert")
            print("sie um.")
        repair = opts["yes"] or (not opts["json"] and is_terminal()
                                 and ask_yes_default("Jetzt reparieren?"))
        if repair:
            ok, out = notebooklm_fix()
            state = notebooklm_state(test=True)
            state["repariert"] = ok
            if not opts["json"]:
                print(f"notebooklm-fix-cookies: {out or ('fertig' if ok else 'fehlgeschlagen')}")
    if opts["json"]:
        sys.stdout.write(dump_json(state))
        return 0 if state["zustand"] == "angemeldet" else 1
    z = state["zustand"]
    if z == "angemeldet":
        who = f" als {state['konto']}" if state["konto"] else ""
        if state["online_geprueft"]:
            print(f"NotebookLM: angemeldet{who}; die Verbindung zu NotebookLM klappt.")
        else:
            print(f"NotebookLM: angemeldet{who}. {state['meldung'] or ''}".rstrip())
        return 0
    if z == "nicht_angemeldet":
        print("NotebookLM: nicht angemeldet.")
    elif z == "unvollstaendig":
        print("NotebookLM: Die Anmeldung ist unvollständig oder abgelaufen"
              + (f" ({state['meldung']})." if state["meldung"] else ".")
              + " Melden Sie sich neu an.")
    else:
        print(f"NotebookLM: Zustand unbekannt ({state['meldung']}).")
    print(NLM_LOGIN)
    return 1


# --- menu on login ---------------------------------------------------------

def menu_off_path():
    return os.path.join(state_dir(), MENU_OFF_FILE)


def menu_on_login():
    return not os.path.exists(menu_off_path())


def set_menu_on_login(enabled):
    path = menu_off_path()
    if enabled:
        if os.path.exists(path):
            try:
                os.unlink(path)
            except PermissionError:
                rc, out = run(["sudo", "-n", "rm", "-f", path])
                if rc != 0:
                    raise CliError(f"Kann {path} nicht löschen: {out.strip()}")
        print("Das Menü öffnet sich wieder, wenn du dich per SSH anmeldest.")
    else:
        write_user_file(path, "Menü beim Anmelden per SSH abgeschaltet "
                              "(wieder einschalten: clawbook, Menü).\n")
        print("Das Menü öffnet sich beim Anmelden per SSH nicht mehr.")
        print("Du öffnest es jederzeit mit: clawbook")


# --- interactive menu ------------------------------------------------------

MENU = """
clawbook - Menü
  GitHub: {github}{restore}
  1  Status
  2  Werkzeuge prüfen
  3  Schlüssel anzeigen
  4  Stand anzeigen
  5  Stand schreiben (~/.clawbook/stand.json)
  6  Pakete und Kurse
  7  {github_item}
  8  {login_item}
  9  NotebookLM-Anmeldung prüfen
  0  Beenden"""


def plain(**kw):
    opts = {"json": False, "quiet": False, "private": False, "yes": False, "write": False,
            "vor_wsm": False, "vorladen": False, "pruefen": False, "dienst": False}
    opts.update(kw)
    return opts


def github_label(state):
    if not state["angemeldet"]:
        return "nicht angemeldet"
    if not state["geprueft"]:
        return "angemeldet (GitHub gerade nicht erreichbar)"
    return f"angemeldet als {state['benutzer'] or 'unbekannt'}"


def menu_key():
    cmd_key_show(plain())
    print()
    print("  p  privaten Schlüssel zeigen")
    print("  n  neues Schlüsselpaar erzeugen")
    print("  Enter  zurück")
    try:
        choice = input("Auswahl: ").strip().lower()
    except EOFError:
        return
    if choice == "p":
        cmd_key_show(plain(private=True))
    elif choice == "n":
        cmd_key_new(plain())


def restore_menu_line():
    r = restore_summary()
    if r["zustand"] == "laeuft":
        return f"\n  Pakete nach neuem Image: werden eingespielt ({', '.join(r['pakete'])})"
    if r["zustand"] == "fehler":
        return ("\n  Pakete nach neuem Image: FEHLER, siehe Status (1); "
                "erneut: clawbook wiederherstellen")
    return ""


def menu_choose_packages(cat, art, heading, hint):
    """Lists the packages of one kind; a number adds or removes one.
    Returns "t" for the technology submenu, None to go back."""
    items = [p for p in cat["pakete"] if p["art"] == art]
    print()
    print(heading)
    if cat["warnung"]:
        print(f"  Hinweis: {cat['warnung']}")
    if restore_state()["zustand"] == "laeuft":
        print("  Hinweis: Die Wiederherstellung nach dem neuen Image läuft noch.")
    print(f"  {hint}")
    for i, p in enumerate(items, 1):
        mark = "[x]" if p["installiert"] else "[ ]"
        print(f"  {i:>2}  {mark} {p['name']:<22} {p['beschreibung']}")
    if art == "kurs":
        print("   t  Technikpakete einzeln (für Fortgeschrittene)")
    print("   Enter  zurück")
    while True:
        try:
            choice = input("Deine Wahl: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return None
        if not choice or choice in ("0", "q", "x"):
            return None
        if choice == "t" and art == "kurs":
            return "t"
        if choice.isdigit() and 1 <= int(choice) <= len(items):
            return items[int(choice) - 1]
        print("Bitte eine Nummer aus der Liste wählen (Enter: zurück).")


def menu_toggle(p):
    """Adds or removes one package; apt shows what happens and asks."""
    print()
    if p["installiert"]:
        print(f"{p['name']} entfernen. Technikpakete, die sonst niemand braucht, gehen mit;")
        print("deine Dateien im Home bleiben.")
        cmd_pakete_remove(plain(), [p["name"]])
    else:
        print(f"{p['name']} hinzufügen ({p['beschreibung']}).")
        cmd_pakete_add(plain(), [p["name"]])


def menu_pakete():
    """Menu "Pakete und Kurse": courses first, single technology packages
    as a submenu for advanced users."""
    print("Paketquellen werden aktualisiert ...", flush=True)
    cat = collect_catalog()
    art = "kurs"
    while True:
        if art == "kurs":
            choice = menu_choose_packages(
                cat, "kurs", "Pakete und Kurse - Kurse",
                "Nummer: Kurs hinzufügen ([ ]) oder entfernen ([x]).")
        else:
            choice = menu_choose_packages(
                cat, "technik", "Technikpakete einzeln (für Fortgeschrittene)",
                "Nummer: Paket hinzufügen ([ ]) oder entfernen ([x]). "
                "Kurse bringen ihre Pakete selbst mit.")
        if choice is None:
            if art == "kurs":
                return
            art = "kurs"
            continue
        if choice == "t":
            art = "technik"
            continue
        try:
            menu_toggle(choice)
        except CliError as e:
            print(f"Fehler: {e}")
        cat = collect_catalog(update=False)


def interactive():
    terminal = is_terminal()
    github = github_state() if terminal else {"angemeldet": False, "benutzer": None,
                                              "geprueft": False}
    # GitHub first: without a login git and wsm do not work properly.
    if terminal and not github["angemeldet"] and github_offer():
        github = github_state()
    # Then, once: an outdated wsm configuration (needs the GitHub name).
    if terminal and github["angemeldet"]:
        try:
            wsm_offer()
        except CliError as e:
            print(f"Fehler: {e}")

    def menu_github():
        nonlocal github
        if github["angemeldet"]:
            github_show()
            git_identity_offer(only_if_unset=True)
        else:
            github_login()
        github = github_state()

    actions = {
        "1": lambda: cmd_status(plain()),
        "2": lambda: cmd_check(plain()),
        "3": menu_key,
        "4": lambda: cmd_stand(plain()),
        "5": lambda: cmd_stand(plain(write=True)),
        "6": menu_pakete,
        "7": menu_github,
        "8": lambda: set_menu_on_login(not menu_on_login()),
        "9": lambda: cmd_notebooklm(plain()),
    }
    while True:
        print(MENU.format(
            github=github_label(github),
            restore=restore_menu_line(),
            github_item="GitHub-Anmeldung prüfen" if github["angemeldet"] else "GitHub anmelden",
            login_item=("Menü beim Anmelden per SSH nicht mehr zeigen" if menu_on_login()
                        else "Menü beim Anmelden per SSH wieder zeigen")))
        try:
            choice = input("Deine Wahl: ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if not choice:
            continue
        if choice in ("0", "q", "x"):
            return 0
        action = actions.get(choice)
        if action is None:
            print(f"„{choice}“ gibt es nicht; wähle eine Nummer aus der Liste.")
            continue
        print()
        try:
            action()
        except CliError as e:
            print(f"Fehler: {e}")
        except KeyboardInterrupt:
            print("\nAbgebrochen.")


# --- command line ----------------------------------------------------------

FLAGS = {"--json": "json", "--quiet": "quiet", "-q": "quiet", "--private": "private",
         "--yes": "yes", "-y": "yes", "--write": "write", "--vor-wsm": "vor_wsm",
         "--vorladen": "vorladen", "--pruefen": "pruefen", "--dienst": "dienst"}


def version_text():
    commit = read_build().get("commit") or "unbekannt"
    return f"clawbook (Schnittstelle {SCHNITTSTELLE}, Build {commit})"


def dispatch(words, opts):
    cmd, args = words[0], words[1:]
    if cmd == "status" and not args:
        return cmd_status(opts)
    if cmd == "check" and not args:
        return cmd_check(opts)
    if cmd == "key":
        if args == ["show"]:
            return cmd_key_show(opts)
        if args == ["new"]:
            return cmd_key_new(opts)
        raise CliError("Aufruf: clawbook key show [--private] | clawbook key new [--yes]",
                       code=2)
    if cmd == "stand" and not args:
        return cmd_stand(opts)
    if cmd == "kurse" and not args:
        return cmd_kurse(opts)
    if cmd == "kurs":
        return cmd_kurs(opts, args)
    if cmd == "pakete":
        return cmd_pakete(opts, args)
    if cmd == "wiederherstellen" and not args:
        return cmd_wiederherstellen(opts)
    if cmd == "github":
        return cmd_github(opts, args)
    if cmd == "notebooklm" and not args:
        return cmd_notebooklm(opts)
    if cmd == "wsm":
        return cmd_wsm(opts, args)
    raise CliError(f"Unbekannter Befehl: {' '.join(words)} (Hilfe: clawbook --help)",
                   code=2)


def main(argv):
    try:
        sys.stdout.reconfigure(encoding="utf-8")
    except (AttributeError, ValueError):
        pass
    opts = plain()
    words = []
    for a in argv:
        if a in ("-h", "--help", "help"):
            sys.stdout.write(HELP)
            return 0
        if a == "--version":
            print(version_text())
            return 0
        if a in FLAGS:
            opts[FLAGS[a]] = True
        elif a.startswith("-"):
            words = None
            bad = a
            break
        else:
            words.append(a)
    try:
        if words is None:
            raise CliError(f"Unbekannte Option: {bad} (Hilfe: clawbook --help)", code=2)
        if not words:
            if opts["json"]:
                raise CliError("--json braucht einen Befehl, z. B. clawbook status --json",
                               code=2)
            return interactive()
        return dispatch(words, opts)
    except CliError as e:
        if opts["json"]:
            sys.stdout.write(dump_json({"fehler": str(e)}))
        else:
            print(f"clawbook: {e}", file=sys.stderr)
        return e.code
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
