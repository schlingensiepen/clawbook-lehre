def home_path(rel):
    return os.path.join(user_home(), rel)


def agenten_work_dir():
    """~/.clawbook/agenten, owned by the working user (created if missing)."""
    path = os.path.join(state_dir(), AGENTEN_WORK_DIR)
    if not os.path.isdir(path):
        try:
            os.makedirs(path, exist_ok=True)
            chown_to_user(path)
        except PermissionError:
            rc, out = run(["sudo", "-n", "install", "-d", "-o", USER_NAME, "-g", USER_NAME,
                           path])
            if rc != 0:
                raise CliError(f"Kann {path} nicht anlegen: {out.strip()}")
    return path


def agent_env():
    """Environment for the agents' own commands: the working user's home."""
    return dict(os.environ, HOME=user_home())


def run_agent(cmd, timeout=120):
    return capture(cmd, timeout, env=agent_env())


def last_line(out):
    lines = [ln.strip() for ln in out.strip().splitlines() if ln.strip()]
    return lines[-1] if lines else "keine Ausgabe"


# --- agenten: keys -----------------------------------------------------------

SECRETS_HEAD = ("# clawbook: Schlüssel für die Agenten-Ausstattung "
                "(clawbook agenten schluessel <NAME>).\n"
                "# Nur für Sie lesbar. Nicht weitergeben, nie in ein Repository.\n")


def secrets_path():
    return os.path.join(state_dir(), SECRETS_FILE)


def read_secrets():
    """Keys from ~/.clawbook/secrets (KEY=VALUE per line); empty values do
    not count."""
    try:
        with open(secrets_path(), encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        return {}
    except OSError as e:
        raise CliError(f"Kann {secrets_path()} nicht lesen: {e}")
    values = {}
    for line in text.splitlines():
        if not line or line.lstrip().startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if ENV_NAME_RE.match(key) and value:
            values[key] = value
    return values


def write_secrets(values):
    text = SECRETS_HEAD + "".join(f"{k}={v}\n" for k, v in sorted(values.items()))
    write_user_file(secrets_path(), text, mode=0o600, tmp_dir=agenten_work_dir())


# --- agenten: definitions ----------------------------------------------------

def str_list(value, what):
    if not isinstance(value, list) or not all(isinstance(x, str) for x in value):
        raise ValueError(f"„{what}“ muss eine Liste von Texten sein")
    return value


def str_dict(value, what):
    if not isinstance(value, dict) or not all(isinstance(k, str) and isinstance(v, str)
                                              for k, v in value.items()):
        raise ValueError(f"„{what}“ muss ein Objekt mit Texten sein")
    return dict(value)


def check_entry(item):
    """Validates one definition; returns the normalized entry."""
    if not isinstance(item, dict):
        raise ValueError("Eintrag ist kein JSON-Objekt")
    name = item.get("name")
    if not isinstance(name, str) or not ENTRY_NAME_RE.match(name):
        raise ValueError(f"ungültiger Name {name!r} (Kleinbuchstaben, Ziffern, . _ -)")
    agents = [AGENT_ALIASES.get(a, a) for a in str_list(item.get("agenten", ["*"]), "agenten")]
    unknown = [a for a in agents if a != "*" and a not in AGENT_NAMES]
    if unknown:
        raise ValueError(f"{name}: unbekannte Agenten {', '.join(unknown)} "
                         f"(bekannt: {', '.join(AGENT_IDS)})")
    entry = {"name": name, "art": item.get("art"), "aus": item.get("aus") is True,
             "beschreibung": str(item.get("beschreibung") or ""),
             "agenten": list(AGENT_IDS) if "*" in agents else agents}
    if entry["aus"]:
        return entry
    entry["benoetigt"] = str_list(item.get("benoetigt", []), "benoetigt")
    bad = [v for v in entry["benoetigt"] if not ENV_NAME_RE.match(v)]
    if bad:
        raise ValueError(f"{name}: ungültige Namen in „benoetigt“: {', '.join(bad)}")
    art = entry["art"]
    if art == "mcp":
        transport = item.get("transport", "stdio")
        entry["transport"] = transport
        if transport == "stdio":
            if not isinstance(item.get("command"), str) or not item["command"]:
                raise ValueError(f"{name}: „command“ fehlt")
            entry["command"] = item["command"]
            entry["args"] = str_list(item.get("args", []), "args")
            entry["env"] = str_dict(item.get("env", {}), "env")
        elif transport == "http":
            url = item.get("url")
            if not isinstance(url, str) or not re.match(r"^https?://", url):
                raise ValueError(f"{name}: „url“ fehlt oder beginnt nicht mit http(s)://")
            entry["url"] = url
            entry["headers"] = str_dict(item.get("headers", {}), "headers")
        else:
            raise ValueError(f"{name}: „transport“ muss stdio oder http sein")
    elif art == "skill":
        quelle = item.get("quelle")
        kinds = [k for k in ("befehl", "befehl_je_ziel", "verzeichnis", "verzeichnis_je_ziel")
                 if isinstance(quelle, dict) and k in quelle]
        if len(kinds) != 1:
            raise ValueError(f"{name}: „quelle“ braucht genau eines von befehl, "
                             "befehl_je_ziel, verzeichnis, verzeichnis_je_ziel")
        kind = kinds[0]
        if kind == "befehl":
            if not str_list(quelle["befehl"], "befehl"):
                raise ValueError(f"{name}: „befehl“ ist leer")
        elif kind == "verzeichnis":
            if not isinstance(quelle["verzeichnis"], str) or not os.path.isabs(quelle["verzeichnis"]):
                raise ValueError(f"{name}: „verzeichnis“ muss ein absoluter Pfad sein")
        else:
            per = quelle[kind]
            if not isinstance(per, dict) or not per or any(z not in SKILL_TARGETS for z in per):
                raise ValueError(f"{name}: „{kind}“ braucht Ziele aus "
                                 f"{', '.join(SKILL_TARGETS)}")
            for z, v in per.items():
                if kind == "befehl_je_ziel" and not str_list(v, f"{kind}.{z}"):
                    raise ValueError(f"{name}: „{kind}.{z}“ ist leer")
                if kind == "verzeichnis_je_ziel" and not (isinstance(v, str) and os.path.isabs(v)):
                    raise ValueError(f"{name}: „{kind}.{z}“ muss ein absoluter Pfad sein")
        entry["quelle"] = {kind: quelle[kind]}
    elif art == "anweisung":
        if isinstance(item.get("text"), str):
            entry["text"] = item["text"]
        elif isinstance(item.get("datei"), str) and os.path.isabs(item["datei"]):
            entry["datei"] = item["datei"]
        else:
            raise ValueError(f"{name}: „text“ oder „datei“ (absoluter Pfad) fehlt")
        order = item.get("reihenfolge", 50)
        if not isinstance(order, int) or isinstance(order, bool):
            raise ValueError(f"{name}: „reihenfolge“ muss eine Zahl sein")
        entry["reihenfolge"] = order
    else:
        raise ValueError(f"{name}: „art“ muss mcp, skill oder anweisung sein")
    return entry


def load_entries():
    """All definitions by name (own ones replace the image's) and warnings."""
    entries, warnings = {}, []
    for herkunft, directory in (("image", AGENTEN_SYSTEM_DIR),
                                ("eigene", os.path.join(state_dir(), AGENTEN_USER_DIR))):
        try:
            names = sorted(n for n in os.listdir(directory) if n.endswith(".json"))
        except OSError:
            continue
        for fname in names:
            path = os.path.join(directory, fname)
            try:
                data = read_json(path)
            except (OSError, ValueError) as e:
                warnings.append(f"{path}: kein gültiges JSON ({e})")
                continue
            for item in data if isinstance(data, list) else [data]:
                try:
                    entry = check_entry(item)
                except ValueError as e:
                    warnings.append(f"{path}: {e}")
                    continue
                entry.update(herkunft=herkunft, definition=path)
                entries.pop(entry["name"], None)
                entries[entry["name"]] = entry
    return entries, warnings


def entry_missing(entry, secrets):
    return [v for v in entry.get("benoetigt", []) if not secrets.get(v)]


def var_refs(value):
    return VAR_RE.findall(value)


def exact_ref(value):
    m = VAR_RE.fullmatch(value)
    return m.group(1) if m else None


def subst(value, secrets):
    return VAR_RE.sub(lambda m: secrets.get(m.group(1), ""), value)


def drop_unset(mapping, secrets):
    """Values referring to a key that is not set are left out."""
    return {k: v for k, v in mapping.items() if all(secrets.get(n) for n in var_refs(v))}


# --- agenten: MCP per agent ------------------------------------------------
# Builders return (configuration as the agent stores it, plain text key).

def mcp_claude(e, secrets):
    if e["transport"] == "stdio":
        conf = {"type": "stdio", "command": e["command"], "args": e["args"]}
        env = drop_unset(e["env"], secrets)
        if env:
            conf["env"] = env
    else:
        conf = {"type": "http", "url": e["url"]}
        headers = drop_unset(e["headers"], secrets)
        if headers:
            conf["headers"] = headers
    return conf, False


def mcp_codex(e, secrets):
    plain = False
    if e["transport"] == "stdio":
        conf = {"command": e["command"]}
        if e["args"]:
            conf["args"] = e["args"]
        env, env_vars = {}, []
        for k, v in drop_unset(e["env"], secrets).items():
            if exact_ref(v) == k:
                env_vars.append(k)
            elif var_refs(v):
                env[k], plain = subst(v, secrets), True
            else:
                env[k] = v
        if env:
            conf["env"] = env
        if env_vars:
            conf["env_vars"] = env_vars
        return conf, plain
    conf = {"url": e["url"]}
    headers, env_headers = {}, {}
    for k, v in drop_unset(e["headers"], secrets).items():
        bearer = re.fullmatch(r"Bearer \$\{([A-Za-z_][A-Za-z0-9_]*)\}", v)
        if exact_ref(v):
            env_headers[k] = exact_ref(v)
        elif k.lower() == "authorization" and bearer:
            conf["bearer_token_env_var"] = bearer.group(1)
        elif var_refs(v):
            headers[k], plain = subst(v, secrets), True
        else:
            headers[k] = v
    if headers:
        conf["http_headers"] = headers
    if env_headers:
        conf["env_http_headers"] = env_headers
    return conf, plain


def mcp_copilot(e, secrets):
    # Copilot passes only PATH to stdio servers; everything else goes into
    # "env" and Copilot resolves ${NAME} itself.
    if e["transport"] == "stdio":
        return {"type": "local", "command": e["command"], "args": e["args"],
                "env": drop_unset(e["env"], secrets)}, False
    return {"type": "http", "url": e["url"], "headers": drop_unset(e["headers"], secrets)}, False


def oc_ref(value):
    return VAR_RE.sub(lambda m: "{env:" + m.group(1) + "}", value)


def mcp_opencode(e, secrets):
    if e["transport"] == "stdio":
        conf = {"type": "local", "command": [e["command"]] + e["args"], "enabled": True}
        env = {k: oc_ref(v) for k, v in drop_unset(e["env"], secrets).items()}
        if env:
            conf["environment"] = env
    else:
        conf = {"type": "remote", "url": e["url"], "enabled": True}
        headers = {k: oc_ref(v) for k, v in drop_unset(e["headers"], secrets).items()}
        if headers:
            # A key in the header: no OAuth attempt.
            conf.update(headers=headers, oauth=False)
    return conf, False


def mcp_agy(e, secrets):
    # agy resolves no variables at all: stdio servers inherit agy's
    # environment (same name: nothing to write), everything else is plain.
    plain = False
    if e["transport"] == "stdio":
        conf = {"command": e["command"], "args": e["args"], "env": {}}
        for k, v in drop_unset(e["env"], secrets).items():
            if exact_ref(v) == k:
                continue
            if var_refs(v):
                plain = True
            conf["env"][k] = subst(v, secrets)
        return conf, plain
    headers = {}
    for k, v in drop_unset(e["headers"], secrets).items():
        if var_refs(v):
            plain = True
        headers[k] = subst(v, secrets)
    return {"serverUrl": e["url"], "headers": headers}, plain


MCP_BUILDERS = {"claude": mcp_claude, "codex": mcp_codex, "copilot": mcp_copilot,
                "opencode": mcp_opencode, "agy": mcp_agy}


def mcp_norm(agent, conf):
    """Comparable form of a stored server (fields the agent adds itself
    and empty values dropped)."""
    if not isinstance(conf, dict):
        return conf
    skip = {"copilot": ("tools", "source", "enabled"), "agy": ("disabled",)}.get(agent, ())
    return {k: v for k, v in conf.items() if k not in skip and v not in ([], {}, None)}


def mcp_equal(agent, current, wanted):
    return current is not None and mcp_norm(agent, current) == mcp_norm(agent, wanted)


def read_json_file(path):
    """JSON object from path; {} when missing. ValueError when unusable."""
    try:
        with open(path, encoding="utf-8-sig") as f:
            text = f.read()
    except FileNotFoundError:
        return {}
    except OSError as e:
        raise ValueError(f"{path}: {e}")
    if not text.strip():
        return {}
    data = json.loads(text)
    if not isinstance(data, dict):
        raise ValueError(f"{path}: kein JSON-Objekt")
    return data


def opencode_config_path():
    base = home_path(".config/opencode")
    for name in ("opencode.jsonc", "opencode.json"):
        if os.path.isfile(os.path.join(base, name)):
            return os.path.join(base, name)
    return os.path.join(base, "opencode.json")


def mcp_read(agent):
    """{name: configuration} of the agent's user-level MCP servers."""
    if agent == "codex":
        try:
            with open(home_path(MCP_FILES["codex"]), "rb") as f:
                data = tomllib.load(f)
        except FileNotFoundError:
            return {}
        except (OSError, tomllib.TOMLDecodeError) as e:
            raise ValueError(f"{home_path(MCP_FILES['codex'])}: {e}")
        servers = data.get("mcp_servers", {})
    elif agent == "opencode":
        path = opencode_config_path()
        try:
            with open(path, encoding="utf-8-sig") as f:
                text = f.read()
        except FileNotFoundError:
            return {}
        except OSError as e:
            raise ValueError(f"{path}: {e}")
        servers = jsonc_data(jsonc_parse(text)).get("mcp", {}) if text.strip() else {}
    else:
        servers = read_json_file(home_path(MCP_FILES[agent])).get("mcpServers", {})
    return servers if isinstance(servers, dict) else {}


# --- agenten: Codex config.toml ---------------------------------------------

def toml_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, list):
        return "[" + ", ".join(toml_value(x) for x in v) + "]"
    return json.dumps(v, ensure_ascii=False)


def toml_key(k):
    return k if re.fullmatch(r"[A-Za-z0-9_-]+", k) else json.dumps(k, ensure_ascii=False)


def codex_tables(name, conf):
    head = f"mcp_servers.{toml_key(name)}"
    text = f"[{head}]\n"
    subs = []
    for k, v in conf.items():
        if isinstance(v, dict):
            subs.append((k, v))
        else:
            text += f"{toml_key(k)} = {toml_value(v)}\n"
    for k, v in subs:
        text += f"\n[{head}.{toml_key(k)}]\n"
        text += "".join(f"{toml_key(a)} = {toml_value(b)}\n" for a, b in v.items())
    return text


CODEX_HEADER_RE = re.compile(
    r'^\s*\[\s*mcp_servers\s*\.\s*(?:"((?:[^"\\]|\\.)*)"|([A-Za-z0-9_-]+))\s*(?:\..*)?\]\s*(?:#.*)?$')


def toml_remove_servers(text, names):
    """Removes the tables [mcp_servers.NAME] and [mcp_servers.NAME.*] of the
    given names, line by line (comments elsewhere stay)."""
    out, skipping = [], False
    for line in text.splitlines(keepends=True):
        if re.match(r"^\s*\[", line):
            m = CODEX_HEADER_RE.match(line)
            name = None
            if m:
                name = json.loads(f'"{m.group(1)}"') if m.group(1) is not None else m.group(2)
            skipping = name in names
        if not skipping:
            out.append(line)
    return re.sub(r"\n{3,}", "\n\n", "".join(out))


def codex_apply(to_set, to_remove, plain):
    path = home_path(MCP_FILES["codex"])
    try:
        with open(path, encoding="utf-8") as f:
            old = f.read()
        mode = os.stat(path).st_mode & 0o777
    except FileNotFoundError:
        old, mode = "", 0o600
    text = toml_remove_servers(old, set(to_set) | set(to_remove)).rstrip("\n")
    for name, conf in to_set.items():
        text += ("\n\n" if text else "") + codex_tables(name, conf).rstrip("\n")
    text += "\n"
    try:
        servers = tomllib.loads(text).get("mcp_servers", {})
    except tomllib.TOMLDecodeError as e:
        raise ValueError(f"{path} wäre danach ungültig ({e}); nichts geändert")
    if any(servers.get(n) != c for n, c in to_set.items()) or any(n in servers for n in to_remove):
        raise ValueError(f"{path}: Die Einträge ließen sich nicht sauber ersetzen (eigene "
                         "Schreibweise der Tabellen?); nichts geändert")
    write_user_file(path, text, mode=0o600 if plain else mode)


# --- agenten: JSONC (OpenCode) ------------------------------------------------
# A small parser that keeps the positions of every value, so that single
# members can be replaced, added or removed without touching comments.

class JsoncParser:
    NUMBER_RE = re.compile(r"-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?|true|false|null")

    def __init__(self, text):
        self.t = text

    def ws(self, i):
        t, n = self.t, len(self.t)
        while i < n:
            if t[i] in " \t\r\n﻿":
                i += 1
            elif t.startswith("//", i):
                j = t.find("\n", i)
                i = n if j < 0 else j + 1
            elif t.startswith("/*", i):
                j = t.find("*/", i + 2)
                if j < 0:
                    raise ValueError("Kommentar ohne Ende")
                i = j + 2
            else:
                break
        return i

    def char(self, i):
        return self.t[i] if i < len(self.t) else ""

    def string_end(self, i):
        j = i + 1
        while j < len(self.t):
            if self.t[j] == "\\":
                j += 2
            elif self.t[j] == '"':
                return j + 1
            else:
                j += 1
        raise ValueError("Zeichenkette ohne Ende")

    def value(self, i):
        i = self.ws(i)
        c = self.char(i)
        if c == "{":
            node = {"k": "o", "s": i, "m": []}
            i = self.ws(i + 1)
            while self.char(i) != "}":
                if self.char(i) != '"':
                    raise ValueError(f"Schlüssel erwartet an Stelle {i}")
                ke = self.string_end(i)
                key = json.loads(self.t[i:ke])
                j = self.ws(ke)
                if self.char(j) != ":":
                    raise ValueError(f"„:“ erwartet an Stelle {j}")
                val = self.value(j + 1)
                node["m"].append({"key": key, "ks": i, "v": val})
                i = self.ws(val["e"])
                if self.char(i) == ",":
                    i = self.ws(i + 1)
                elif self.char(i) != "}":
                    raise ValueError(f"„,“ oder „}}“ erwartet an Stelle {i}")
            node["e"] = i + 1
            return node
        if c == "[":
            node = {"k": "a", "s": i, "items": []}
            i = self.ws(i + 1)
            while self.char(i) != "]":
                val = self.value(i)
                node["items"].append(val)
                i = self.ws(val["e"])
                if self.char(i) == ",":
                    i = self.ws(i + 1)
                elif self.char(i) != "]":
                    raise ValueError(f"„,“ oder „]“ erwartet an Stelle {i}")
            node["e"] = i + 1
            return node
        if c == '"':
            j = self.string_end(i)
            return {"k": "v", "s": i, "e": j, "v": json.loads(self.t[i:j])}
        m = self.NUMBER_RE.match(self.t, i)
        if not m:
            raise ValueError(f"unerwartetes Zeichen an Stelle {i}")
        return {"k": "v", "s": i, "e": m.end(), "v": json.loads(m.group(0))}


def jsonc_parse(text):
    p = JsoncParser(text)
    node = p.value(0)
    if p.ws(node["e"]) != len(text):
        raise ValueError("Text nach dem Ende des JSON-Objekts")
    return node


def jsonc_data(node):
    if node["k"] == "o":
        return {m["key"]: jsonc_data(m["v"]) for m in node["m"]}
    if node["k"] == "a":
        return [jsonc_data(x) for x in node["items"]]
    return node["v"]


def line_indent(text, pos):
    start = text.rfind("\n", 0, pos) + 1
    return re.match(r"[ \t]*", text[start:pos]).group(0)


def json_indented(value, indent):
    return json.dumps(value, indent=2, ensure_ascii=False).replace("\n", "\n" + indent)


def jsonc_set(text, path, value):
    """Sets the member at path (list of keys) to value."""
    node = jsonc_parse(text)
    for depth, key in enumerate(path):
        if node["k"] != "o":
            raise ValueError(f"„{path[depth - 1]}“ ist kein Objekt")
        member = next((m for m in node["m"] if m["key"] == key), None)
        rest = path[depth + 1:]
        if member is None:
            for k in reversed(rest):
                value = {k: value}
            if node["m"]:
                last = node["m"][-1]
                ind = line_indent(text, last["ks"])
                pos = last["v"]["e"]
                return (text[:pos] + ",\n" + ind + json.dumps(key) + ": "
                        + json_indented(value, ind) + text[pos:])
            base = line_indent(text, node["s"])
            ind = base + "  "
            pos = node["s"] + 1
            inner = text[pos:node["e"] - 1]
            member_text = json.dumps(key) + ": " + json_indented(value, ind)
            if not inner.strip():
                return text[:pos] + "\n" + ind + member_text + "\n" + base + text[node["e"] - 1:]
            return text[:pos] + "\n" + ind + member_text + text[pos:]
        if not rest:
            ind = line_indent(text, member["ks"])
            return text[:member["v"]["s"]] + json_indented(value, ind) + text[member["v"]["e"]:]
        node = member["v"]
    return text


def jsonc_remove(text, path):
    """Removes the member at path; unchanged when it does not exist."""
    p = JsoncParser(text)
    node = jsonc_parse(text)
    for key in path[:-1]:
        member = next((m for m in node["m"] if m["key"] == key), None) if node["k"] == "o" else None
        if member is None:
            return text
        node = member["v"]
    if node["k"] != "o":
        return text
    members = node["m"]
    idx = next((i for i, m in enumerate(members) if m["key"] == path[-1]), None)
    if idx is None:
        return text
    member = members[idx]
    start, end = member["ks"], member["v"]["e"]
    j = p.ws(end)
    if p.char(j) == ",":
        line_start = text.rfind("\n", 0, start) + 1
        if not text[line_start:start].strip():
            start = line_start
        end = j + 1
        end += re.match(r"[ \t]*\n?", text[end:]).end()
        return text[:start] + text[end:]
    start = members[idx - 1]["v"]["e"] if idx > 0 else node["s"] + 1
    return text[:start] + text[end:]


def opencode_apply(to_set, to_remove):
    path = opencode_config_path()
    try:
        with open(path, encoding="utf-8-sig") as f:
            text = f.read()
        mode = os.stat(path).st_mode & 0o777
    except FileNotFoundError:
        text, mode = "", 0o644
    if not text.strip():
        text = '{\n  "$schema": "https://opencode.ai/config.json"\n}\n'
    for name in to_remove:
        text = jsonc_remove(text, ["mcp", name])
    for name, conf in to_set.items():
        text = jsonc_set(text, ["mcp", name], conf)
    servers = jsonc_data(jsonc_parse(text)).get("mcp", {})
    if any(servers.get(n) != c for n, c in to_set.items()) or any(n in servers for n in to_remove):
        raise ValueError(f"{path}: Die Einträge ließen sich nicht sauber ersetzen; nichts geändert")
    write_user_file(path, text, mode=mode)


# --- agenten: MCP apply --------------------------------------------------------

def mcp_cli_set(agent, name, conf, present):
    """Adds (or replaces) one server with the agent's own command.
    Returns None or an error text."""
    if agent == "claude":
        if present:
            run_agent(["claude", "mcp", "remove", "-s", "user", name])
        rc, out = run_agent(["claude", "mcp", "add-json", "-s", "user", name, json.dumps(conf)])
    elif agent == "copilot":
        if present:
            run_agent(["copilot", "mcp", "remove", name])
        if conf["type"] == "local":
            cmd = ["copilot", "mcp", "add"]
            for k, v in conf.get("env", {}).items():
                cmd += ["--env", f"{k}={v}"]
            cmd += [name, "--", conf["command"]] + conf.get("args", [])
        else:
            cmd = ["copilot", "mcp", "add", "--transport", "http"]
            for k, v in conf.get("headers", {}).items():
                cmd += ["--header", f"{k}: {v}"]
            cmd += [name, conf["url"]]
        rc, out = run_agent(cmd)
    else:  # agy: "add or update"
        cmd = ["agy", "mcp", "add"]
        if "serverUrl" in conf:
            for k, v in conf.get("headers", {}).items():
                cmd += ["--header", f"{k}: {v}"]
            cmd += [name, conf["serverUrl"]]
        else:
            for k, v in conf.get("env", {}).items():
                cmd += ["--env", f"{k}={v}"]
            cmd += [name, "--", conf["command"]] + conf.get("args", [])
        rc, out = run_agent(cmd)
    return None if rc == 0 else last_line(out)


def mcp_cli_remove(agent, name):
    cmd = {"claude": ["claude", "mcp", "remove", "-s", "user", name],
           "copilot": ["copilot", "mcp", "remove", name],
           "agy": ["agy", "mcp", "remove", name]}[agent]
    rc, out = run_agent(cmd)
    return None if rc == 0 else last_line(out)


def secure_agy_config():
    """agy writes its file world-readable; it may hold a key in plain text."""
    path = home_path(MCP_FILES["agy"])
    if os.path.isfile(path) and os.stat(path).st_mode & 0o077:
        os.chmod(path, 0o600)


def sync_mcp(agent, desired, plain, managed, report):
    """Brings the agent's MCP servers in line; returns the managed names."""
    try:
        current = mcp_read(agent)
    except ValueError as e:
        report["fehler"].append(f"MCP-Konfiguration nicht lesbar, nichts geändert: {e}")
        return sorted(managed)
    to_set = {n: c for n, c in desired.items() if not mcp_equal(agent, current.get(n), c)}
    to_remove = [n for n in sorted(managed) if n not in desired and n in current]
    failed = set()
    if agent in ("codex", "opencode"):
        if to_set or to_remove:
            try:
                if agent == "codex":
                    codex_apply(to_set, to_remove, plain)
                else:
                    opencode_apply(to_set, to_remove)
            except (ValueError, CliError) as e:
                report["fehler"].append(f"MCP: {e}")
                failed = set(to_set) | set(to_remove)
    else:
        for name in to_remove:
            err = mcp_cli_remove(agent, name)
            if err:
                report["fehler"].append(f"MCP {name} nicht entfernt: {err}")
                failed.add(name)
        for name, conf in to_set.items():
            err = mcp_cli_set(agent, name, conf, name in current)
            if err:
                report["fehler"].append(f"MCP {name} nicht eingetragen: {err}")
                failed.add(name)
        if agent == "agy":
            secure_agy_config()
    for name in to_set:
        if name in failed:
            continue
        if name not in current:
            report["aenderungen"].append(f"MCP {name} eingetragen")
        elif name in managed:
            report["aenderungen"].append(f"MCP {name} aktualisiert")
        else:
            report["aenderungen"].append(f"MCP {name} übernommen (ersetzt einen Eintrag "
                                         "gleichen Namens)")
    for name in to_remove:
        if name not in failed:
            report["aenderungen"].append(f"MCP {name} entfernt")
    keep = {n for n in desired if n not in failed or n in managed}
    keep |= {n for n in to_remove if n in failed}
    return sorted(keep)


# --- agenten: skills -----------------------------------------------------------

def exe_fingerprint(command):
    path = shutil.which(command)
    if not path:
        return f"{command}:fehlt"
    real = os.path.realpath(path)
    try:
        st = os.stat(real)
    except OSError:
        return real
    return f"{real}:{st.st_size}:{int(st.st_mtime)}"


def tree_signature(path):
    """(relative path, content hash or link target, executable) of every
    file below path - to compare two skill folders."""
    sig = []
    for root, dirs, files in os.walk(path):
        dirs.sort()
        for name in sorted(files):
            full = os.path.join(root, name)
            rel = os.path.relpath(full, path)
            if os.path.islink(full):
                sig.append((rel, "->" + os.readlink(full), False))
                continue
            try:
                with open(full, "rb") as f:
                    digest = hashlib.sha256(f.read()).hexdigest()
            except OSError:
                digest = "?"
            sig.append((rel, digest, os.access(full, os.X_OK)))
    return sig


def run_vendor(cmd, name, work):
    """Runs a vendor command with a throwaway HOME (it writes into HOME and
    the working directory); returns ({target: skill folder}, sandbox, error)."""
    sandbox = tempfile.mkdtemp(prefix="sandbox-", dir=work)
    cwd = os.path.join(sandbox, "arbeit")
    os.makedirs(cwd)
    env = {k: v for k, v in os.environ.items() if not k.startswith("XDG_")}
    env["HOME"] = sandbox
    rc, out = capture(cmd, 300, env=env, cwd=cwd)
    found = {}
    for ziel, rels in SKILL_FOUND.items():
        for base in (sandbox, cwd):
            for rel in rels:
                path = os.path.join(base, rel, name)
                if os.path.isfile(os.path.join(path, "SKILL.md")):
                    found.setdefault(ziel, path)
    if rc != 0:
        return found, sandbox, f"{' '.join(cmd)}: {last_line(out)}"
    if not found:
        return found, sandbox, f"{' '.join(cmd)} hat keinen Skill „{name}“ angelegt"
    return found, sandbox, None


def pick_found(found, ziel):
    for z in (ziel, "agents", "claude", "antigravity"):
        if z in found:
            return found[z]
    return None


def skill_sources(entry):
    """{target: folder} of a skill. Vendor commands run once per image
    build and definition; the result is kept in ~/.clawbook/agenten/quellen.
    Raises ValueError on failure."""
    quelle = entry["quelle"]
    if "verzeichnis" in quelle:
        if not os.path.isfile(os.path.join(quelle["verzeichnis"], "SKILL.md")):
            raise ValueError(f"{quelle['verzeichnis']} enthält kein SKILL.md")
        return {z: quelle["verzeichnis"] for z in SKILL_TARGETS}
    if "verzeichnis_je_ziel" in quelle:
        for d in quelle["verzeichnis_je_ziel"].values():
            if not os.path.isfile(os.path.join(d, "SKILL.md")):
                raise ValueError(f"{d} enthält kein SKILL.md")
        return dict(quelle["verzeichnis_je_ziel"])
    cmds = ([quelle["befehl"]] if "befehl" in quelle
            else list(quelle["befehl_je_ziel"].values()))
    key = hashlib.sha256(json.dumps(
        [quelle, read_build().get("commit"), [exe_fingerprint(c[0]) for c in cmds]],
        sort_keys=True).encode()).hexdigest()[:16]
    work = agenten_work_dir()
    base = os.path.join(work, "quellen", entry["name"])
    cache = os.path.join(base, key)
    if os.path.isfile(os.path.join(cache, ".fertig")):
        return {z: os.path.join(cache, z) for z in SKILL_TARGETS
                if os.path.isdir(os.path.join(cache, z))}
    os.makedirs(base, exist_ok=True)
    new = tempfile.mkdtemp(prefix=".neu-", dir=base)
    sandboxes = []
    try:
        if "befehl" in quelle:
            found, sandbox, err = run_vendor(quelle["befehl"], entry["name"], work)
            sandboxes.append(sandbox)
            if err:
                raise ValueError(err)
            picked = {z: pick_found(found, z) for z in SKILL_TARGETS}
        else:
            picked = {}
            for ziel, cmd in quelle["befehl_je_ziel"].items():
                found, sandbox, err = run_vendor(cmd, entry["name"], work)
                sandboxes.append(sandbox)
                if err:
                    raise ValueError(err)
                picked[ziel] = pick_found(found, ziel)
        for ziel, src in picked.items():
            if src:
                shutil.copytree(src, os.path.join(new, ziel), symlinks=True)
        with open(os.path.join(new, ".fertig"), "w", encoding="utf-8") as f:
            f.write(now_text() + "\n")
        for old in os.listdir(base):
            if old != os.path.basename(new):
                shutil.rmtree(os.path.join(base, old), ignore_errors=True)
        os.rename(new, cache)
    finally:
        shutil.rmtree(new, ignore_errors=True)
        for sandbox in sandboxes:
            shutil.rmtree(sandbox, ignore_errors=True)
    return {z: os.path.join(cache, z) for z in SKILL_TARGETS
            if os.path.isdir(os.path.join(cache, z))}


def install_skill(src, ziel, name, managed):
    """Copies the skill folder into the shared skill folder of the target.
    Returns the change text or None (already the same)."""
    parent = home_path(SKILL_TARGETS[ziel])
    dst = os.path.join(parent, name)
    note = None
    if os.path.lexists(dst):
        if (os.path.isdir(dst) and not os.path.islink(dst)
                and tree_signature(dst) == tree_signature(src)):
            return None if name in managed else f"Skill {name} übernommen"
        if name not in managed:
            backup = os.path.join(agenten_work_dir(), "sicherung",
                                  f"{ziel}-{name}-{now_text().replace(':', '')}")
            os.makedirs(os.path.dirname(backup), exist_ok=True)
            shutil.move(dst, backup)
            note = f"bisherige Fassung gesichert in {backup}"
    os.makedirs(parent, exist_ok=True)
    tmp = os.path.join(parent, f".clawbook-neu-{name}")
    old = os.path.join(parent, f".clawbook-alt-{name}")
    for path in (tmp, old):
        shutil.rmtree(path, ignore_errors=True)
    shutil.copytree(src, tmp, symlinks=True)
    existed = os.path.lexists(dst)
    if existed:
        os.rename(dst, old)
    os.rename(tmp, dst)
    shutil.rmtree(old, ignore_errors=True)
    text = f"Skill {name} {'aktualisiert' if existed else 'eingerichtet'}"
    return f"{text} ({note})" if note else text


def remove_skill(ziel, name):
    dst = os.path.join(home_path(SKILL_TARGETS[ziel]), name)
    if os.path.islink(dst):
        os.unlink(dst)
    elif os.path.isdir(dst):
        shutil.rmtree(dst)


# --- agenten: instructions -----------------------------------------------------

def instruction_text(entries, agent, report):
    parts = []
    for e in sorted(entries, key=lambda x: (x["reihenfolge"], x["name"])):
        if agent not in e["agenten"]:
            continue
        if "text" in e:
            parts.append(e["text"].strip())
            continue
        try:
            with open(e["datei"], encoding="utf-8") as f:
                parts.append(f.read().strip())
        except OSError as err:
            report.append(f"Anweisung {e['name']}: {e['datei']} nicht lesbar ({err})")
    return "\n\n".join(p for p in parts if p)


def instruction_content(agent, text):
    """What sync writes: a marked block, for Antigravity a file of its own."""
    if agent == "agy":
        return f"{AGY_RULE_HEAD}{AGY_RULE_NOTE}\n\n{text}\n"
    return f"{BLOCK_START}\n{BLOCK_NOTE}\n\n{text}\n{BLOCK_END}\n"


def block_span(text):
    """(start, end) of the marked block in text, None when there is none.
    ValueError when the end marker is missing."""
    start = text.find(BLOCK_START)
    if start < 0:
        return None
    end = text.find(BLOCK_END, start)
    if end < 0:
        raise ValueError("Anfangsmarkierung ohne Endmarkierung")
    end += len(BLOCK_END)
    if text[end:end + 1] == "\n":
        end += 1
    return start, end


def instruction_current(agent):
    """The block (or rules file) as it is now, or None."""
    path = home_path(INSTRUCTION_FILES[agent])
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        return None
    if agent == "agy":
        return text
    span = block_span(text)
    return text[span[0]:span[1]] if span else None


def sync_instruction(agent, text, managed, report):
    """Writes, replaces or removes the instruction block. Returns True when
    sync manages it afterwards."""
    path = home_path(INSTRUCTION_FILES[agent])
    wanted = instruction_content(agent, text) if text else None
    try:
        with open(path, encoding="utf-8") as f:
            old = f.read()
        mode = os.stat(path).st_mode & 0o777
    except FileNotFoundError:
        old, mode = None, 0o644
    if agent == "agy":
        if old == wanted:
            return wanted is not None
        if wanted is None:
            if old is not None and managed:
                os.remove(path)
                report["aenderungen"].append("Anweisungen entfernt")
            return False
        if old is not None and not managed:
            backup = os.path.join(agenten_work_dir(), "sicherung",
                                  f"agy-clawbook.md-{now_text().replace(':', '')}")
            os.makedirs(os.path.dirname(backup), exist_ok=True)
            shutil.copy2(path, backup)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        write_user_file(path, wanted)
        report["aenderungen"].append("Anweisungen " + ("eingerichtet" if old is None
                                                       else "aktualisiert"))
        return True
    try:
        span = block_span(old or "")
    except ValueError as e:
        report["fehler"].append(f"{path}: {e}; Anweisungen nicht geändert")
        return managed
    if span is None:
        if wanted is None:
            return False
        new = (old.rstrip("\n") + "\n\n" if old and old.strip() else "") + wanted
        verb = "eingerichtet"
    else:
        current = old[span[0]:span[1]]
        if current == wanted:
            return True
        if wanted is None:
            if not managed:
                return False
            before, after = old[:span[0]].rstrip("\n"), old[span[1]:].lstrip("\n")
            new = before + ("\n\n" if before and after else "\n" if before else "") + after
            verb = "entfernt"
        else:
            new = old[:span[0]] + wanted + old[span[1]:]
            verb = "aktualisiert"
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if verb == "entfernt" and not new.strip() and old is not None:
        os.remove(path)
    else:
        write_user_file(path, new, mode=mode)
    report["aenderungen"].append(f"Anweisungen {verb}")
    return wanted is not None


# --- agenten: sync ------------------------------------------------------------

def agenten_stand_path():
    return os.path.join(state_dir(), AGENTEN_STAND)


def read_agenten_stand():
    try:
        data = read_json(agenten_stand_path())
    except (OSError, ValueError):
        data = {}
    if not isinstance(data, dict):
        data = {}
    verwaltet = data.get("verwaltet") if isinstance(data.get("verwaltet"), dict) else {}
    for part in ("mcp", "skill", "anweisung"):
        if not isinstance(verwaltet.get(part), dict):
            verwaltet[part] = {}
    data["verwaltet"] = verwaltet
    return data


def installed_agents():
    return {a: shutil.which(AGENT_CMD[a]) is not None for a in AGENT_IDS}


def active_ziele(installed):
    return sorted({AGENT_ZIEL[a] for a in AGENT_IDS if installed[a]})


def ziel_agents(ziel, installed):
    return [a for a in AGENT_IDS if AGENT_ZIEL[a] == ziel and installed[a]]


class SyncLock:
    """One sync at a time (start of the container, package changes, menu)."""

    def __enter__(self):
        self.f = open(os.path.join(agenten_work_dir(), "sync.lock"), "w", encoding="utf-8")
        deadline = time.time() + 600
        while True:
            try:
                fcntl.flock(self.f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except BlockingIOError:
                if time.time() > deadline:
                    raise CliError("Ein anderer Abgleich der Agenten-Ausstattung läuft seit "
                                   "über zehn Minuten; bitte später erneut versuchen.")
                time.sleep(1)

    def __exit__(self, *exc):
        self.f.close()


def agenten_sync():
    """Carries all entries into every installed agent. Returns the result."""
    with SyncLock():
        return agenten_sync_locked()


def agenten_sync_locked():
    entries, warnings = load_entries()
    secrets = read_secrets()
    stand = read_agenten_stand()
    verwaltet = stand["verwaltet"]
    installed = installed_agents()
    active = {n: e for n, e in entries.items() if not e["aus"]}
    missing = {n: entry_missing(e, secrets) for n, e in active.items()}
    usable = {n: e for n, e in active.items() if not missing[n]}
    result = {"ok": True, "geaendert": False, "zeit": now_text(), "warnungen": warnings,
              "weggelassen": [{"name": n, "art": active[n]["art"], "fehlt": m}
                              for n, m in missing.items() if m],
              "agenten": {}, "skills": {}, "hinweise": []}
    new_verwaltet = {"mcp": {}, "skill": {}, "anweisung": {}}
    anweisungen = [e for e in usable.values() if e["art"] == "anweisung"]
    for agent in AGENT_IDS:
        report = {"name": AGENT_NAMES[agent], "installiert": installed[agent],
                  "aenderungen": [], "fehler": []}
        result["agenten"][agent] = report
        if not installed[agent]:
            new_verwaltet["mcp"][agent] = verwaltet["mcp"].get(agent, [])
            new_verwaltet["anweisung"][agent] = verwaltet["anweisung"].get(agent, False)
            continue
        desired, plain = {}, False
        for n, e in usable.items():
            if e["art"] == "mcp" and agent in e["agenten"]:
                conf, is_plain = MCP_BUILDERS[agent](e, secrets)
                desired[n] = conf
                plain = plain or is_plain
        managed = set(verwaltet["mcp"].get(agent, []))
        new_verwaltet["mcp"][agent] = sync_mcp(agent, desired, plain, managed, report)
        if agent == "agy" and plain and any(a.startswith("MCP") for a in report["aenderungen"]):
            result["hinweise"].append(
                "Antigravity löst keine Variablen auf: Schlüssel für HTTP-MCP-Server stehen "
                f"im Klartext in ~/{MCP_FILES['agy']} (Datei nur für Sie lesbar).")
        notes = []
        text = instruction_text(anweisungen, agent, notes)
        report["fehler"] += notes
        new_verwaltet["anweisung"][agent] = sync_instruction(
            agent, text, verwaltet["anweisung"].get(agent, False) is True, report)
    for ziel in SKILL_TARGETS:
        agents = ziel_agents(ziel, installed)
        managed = set(verwaltet["skill"].get(ziel, []))
        report = {"agenten": agents, "ordner": "~/" + SKILL_TARGETS[ziel],
                  "aenderungen": [], "fehler": []}
        result["skills"][ziel] = report
        if not agents:
            new_verwaltet["skill"][ziel] = sorted(managed)
            continue
        keep = set()
        for n, e in usable.items():
            if e["art"] != "skill" or not any(a in e["agenten"] for a in agents):
                continue
            try:
                sources = skill_sources(e)
            except (ValueError, OSError) as err:
                report["fehler"].append(f"Skill {n}: {err}")
                if n in managed:
                    keep.add(n)
                continue
            if ziel not in sources:
                continue
            try:
                change = install_skill(sources[ziel], ziel, n, managed)
            except OSError as err:
                report["fehler"].append(f"Skill {n}: {err}")
                if n in managed:
                    keep.add(n)
                continue
            keep.add(n)
            if change:
                report["aenderungen"].append(change)
        for n in sorted(managed - keep):
            try:
                remove_skill(ziel, n)
                report["aenderungen"].append(f"Skill {n} entfernt")
            except OSError as err:
                report["fehler"].append(f"Skill {n} nicht entfernt: {err}")
                keep.add(n)
        new_verwaltet["skill"][ziel] = sorted(keep)
    reports = list(result["agenten"].values()) + list(result["skills"].values())
    result["geaendert"] = any(r["aenderungen"] for r in reports)
    result["ok"] = not any(r["fehler"] for r in reports)
    data = {"format": AGENTEN_STAND_FORMAT, "verwaltet": new_verwaltet,
            "letzter_sync": {"zeit": result["zeit"], "ok": result["ok"],
                             "geaendert": result["geaendert"],
                             "weggelassen": result["weggelassen"],
                             "fehler": [f"{r.get('name', r.get('ordner'))}: {x}"
                                        for r in reports for x in r["fehler"]]}}
    write_user_file(agenten_stand_path(), dump_json(data), tmp_dir=agenten_work_dir())
    return result


def missing_text(item):
    return (f"  {item['name']:<14} fehlt {', '.join(item['fehlt'])}  (setzen: clawbook "
            f"agenten schluessel {item['fehlt'][0]})")


def print_sync(result):
    for agent, r in result["agenten"].items():
        if not r["installiert"]:
            print(f"  {r['name'] + ':':<14} nicht installiert")
            continue
        text = "; ".join(r["aenderungen"]) or "unverändert"
        print(f"  {r['name'] + ':':<14} {text}")
        for err in r["fehler"]:
            print(f"  {'':<14} FEHLER: {err}")
    for ziel, r in result["skills"].items():
        if not r["agenten"]:
            continue
        who = ", ".join(AGENT_NAMES[a] for a in r["agenten"])
        text = "; ".join(r["aenderungen"]) or "unverändert"
        print(f"  Skills {r['ordner']} ({who}): {text}")
        for err in r["fehler"]:
            print(f"      FEHLER: {err}")
    if result["weggelassen"]:
        print("Nicht eingetragen, weil ein Schlüssel fehlt:")
        for item in result["weggelassen"]:
            print(missing_text(item))
    for text in result["hinweise"]:
        print(f"Hinweis: {text}")
    for text in result["warnungen"]:
        print(f"Warnung: {text}")
    if not result["ok"]:
        print("Der Abgleich hatte Fehler (siehe oben); Details: clawbook agenten status")
    elif result["geaendert"]:
        print("Fertig. Laufende Agenten sehen die Änderungen nach einem Neustart.")
    else:
        print("Alles aktuell, nichts geändert.")


def cmd_agenten_sync(opts):
    if not opts["json"]:
        print("Agenten-Ausstattung abgleichen ...", flush=True)
    result = agenten_sync()
    if opts["json"]:
        sys.stdout.write(dump_json(result))
    else:
        print_sync(result)
    return 0 if result["ok"] else 1


def as_user_env(cmd):
    """cmd as the working user with its own home (from root)."""
    return ["runuser", "-u", USER_NAME, "--", "env", f"HOME={user_home()}",
            f"USER={USER_NAME}", f"LOGNAME={USER_NAME}"] + cmd


def agenten_sync_quiet():
    """Sync after a change (packages, start of the container) as the
    working user. Never raises; returns the result (or ok False)."""
    if os.geteuid() == 0:
        rc, out = run_stdout(as_user_env([sys.executable, "-I", os.path.abspath(__file__),
                                           "agenten", "sync", "--json"]), timeout=1800)
        try:
            data = json.loads(out)
            if isinstance(data, dict) and "ok" in data:
                return data
        except ValueError:
            pass
        return {"ok": False, "geaendert": False, "weggelassen": [],
                "fehler": f"clawbook agenten sync: Exit-Code {rc}"}
    try:
        return agenten_sync()
    except (CliError, OSError) as e:
        return {"ok": False, "geaendert": False, "weggelassen": [], "fehler": str(e)}


def sync_summary(result):
    if result.get("fehler"):
        return f"Agenten-Ausstattung: nicht abgeglichen ({result['fehler']})"
    text = ("Agenten-Ausstattung: abgeglichen" if result.get("geaendert")
            else "Agenten-Ausstattung: aktuell")
    if not result.get("ok"):
        text += " - mit Fehlern (clawbook agenten status)"
    missing = [i["name"] for i in result.get("weggelassen", [])]
    if missing:
        text += f"; ohne Schlüssel nicht eingetragen: {', '.join(missing)}"
    return text


def sync_after_change(opts):
    """For pakete add/remove: sync and tell it in one line."""
    say(opts, "Agenten-Ausstattung wird abgeglichen ...")
    result = agenten_sync_quiet()
    say(opts, sync_summary(result))
    return {"ok": result.get("ok", False), "geaendert": result.get("geaendert", False)}


# --- agenten: status ---------------------------------------------------------

STATUS_CELL = {"eingetragen": "ja", "fehlt": "FEHLT", "abweichend": "ANDERS",
               "schluessel_fehlt": "SCHLÜSSEL", "nicht_vorgesehen": "-", "aus": "aus",
               "nicht_installiert": "n. inst."}


def cached_sources(entry):
    """Skill folders from an earlier sync (never runs a command)."""
    quelle = entry["quelle"]
    if "verzeichnis" in quelle:
        return {z: quelle["verzeichnis"] for z in SKILL_TARGETS}
    if "verzeichnis_je_ziel" in quelle:
        return dict(quelle["verzeichnis_je_ziel"])
    base = os.path.join(state_dir(), AGENTEN_WORK_DIR, "quellen", entry["name"])
    try:
        for key in os.listdir(base):
            cache = os.path.join(base, key)
            if os.path.isfile(os.path.join(cache, ".fertig")):
                return {z: os.path.join(cache, z) for z in SKILL_TARGETS
                        if os.path.isdir(os.path.join(cache, z))}
    except OSError:
        pass
    return {}


def collect_agenten_status():
    entries, warnings = load_entries()
    secrets = read_secrets()
    stand = read_agenten_stand()
    installed = installed_agents()
    servers = {}
    for agent in AGENT_IDS:
        try:
            servers[agent] = mcp_read(agent) if installed[agent] else {}
        except ValueError:
            servers[agent] = None
    anweisungen = [e for e in entries.values() if e["art"] == "anweisung" and not e["aus"]
                   and not entry_missing(e, secrets)]
    instructions = {}
    for agent in AGENT_IDS:
        text = instruction_text(anweisungen, agent, [])
        instructions[agent] = (instruction_content(agent, text) if text else None,
                               instruction_current(agent) if installed[agent] else None)
    rows = []
    for name, e in entries.items():
        miss = [] if e["aus"] else entry_missing(e, secrets)
        row = {"name": name, "art": e["art"], "herkunft": e["herkunft"], "aus": e["aus"],
               "beschreibung": e["beschreibung"], "fehlende_schluessel": miss, "agenten": {}}
        sources = cached_sources(e) if e["art"] == "skill" and not e["aus"] else {}
        for agent in AGENT_IDS:
            if not installed[agent]:
                state = "nicht_installiert"
            elif agent not in e["agenten"]:
                state = "nicht_vorgesehen"
            elif e["aus"]:
                state = "aus"
            elif miss:
                state = "schluessel_fehlt"
            elif e["art"] == "mcp":
                current = (servers[agent] or {}).get(name)
                wanted, _ = MCP_BUILDERS[agent](e, secrets)
                state = ("fehlt" if current is None else
                         "eingetragen" if mcp_equal(agent, current, wanted) else "abweichend")
            elif e["art"] == "skill":
                ziel = AGENT_ZIEL[agent]
                dst = os.path.join(home_path(SKILL_TARGETS[ziel]), name)
                if not os.path.isfile(os.path.join(dst, "SKILL.md")):
                    state = "fehlt"
                elif ziel in sources and tree_signature(dst) != tree_signature(sources[ziel]):
                    state = "abweichend"
                else:
                    state = "eingetragen"
            else:
                wanted, current = instructions[agent]
                state = ("fehlt" if current is None else
                         "eingetragen" if current == wanted else "abweichend")
            row["agenten"][agent] = state
        rows.append(row)
    needed = sorted({v for e in entries.values() if not e["aus"]
                     for v in e.get("benoetigt", [])})
    return {"agenten": {a: {"name": AGENT_NAMES[a], "installiert": installed[a]}
                        for a in AGENT_IDS},
            "eintraege": rows,
            "schluessel": {"datei": secrets_path(), "gesetzt": sorted(secrets),
                           "benoetigt": needed,
                           "fehlen": [v for v in needed if v not in secrets]},
            "letzter_sync": stand.get("letzter_sync"),
            "warnungen": warnings}


def print_agenten_status(s):
    print("Agenten-Ausstattung")
    head = f"  {'Eintrag':<16} {'Art':<10}" + "".join(
        f" {s['agenten'][a]['name']:<12}" for a in AGENT_IDS)
    print(head)
    for row in s["eintraege"]:
        cells = "".join(f" {STATUS_CELL[row['agenten'][a]]:<12}" for a in AGENT_IDS)
        print(f"  {row['name']:<16} {row['art'] or '':<10}{cells}")
    print("  ja = eingetragen, FEHLT/ANDERS = beim nächsten Abgleich (clawbook agenten sync),")
    print("  SCHLÜSSEL = ein Schlüssel fehlt, - = für diesen Agenten nicht vorgesehen")
    k = s["schluessel"]
    if k["benoetigt"]:
        print("Schlüssel (Werte werden nie angezeigt):")
        for name in k["benoetigt"]:
            print(f"  {name:<20} {'gesetzt' if name in k['gesetzt'] else 'fehlt'}")
    if k["fehlen"]:
        print(f"Setzen mit: clawbook agenten schluessel {k['fehlen'][0]}")
    last = s["letzter_sync"]
    if last:
        print(f"Letzter Abgleich: {last.get('zeit')}"
              + ("" if last.get("ok") else " - mit Fehlern:"))
        for err in last.get("fehler") or []:
            print(f"  {err}")
    else:
        print("Noch kein Abgleich (clawbook agenten sync).")
    for text in s["warnungen"]:
        print(f"Warnung: {text}")


def cmd_agenten_status(opts):
    s = collect_agenten_status()
    if opts["json"]:
        sys.stdout.write(dump_json(s))
    else:
        print_agenten_status(s)
    return 0


# --- agenten: keys (command) ---------------------------------------------------

def check_secret_name(name):
    if not SECRET_NAME_RE.match(name):
        raise CliError(f"„{name}“ ist kein gültiger Name (Großbuchstaben, Ziffern, _; "
                       "zum Beispiel STITCH_API_KEY).", code=2)
    if name in SECRET_REFUSED:
        raise CliError(f"{name} speichert clawbook nicht: {SECRET_REFUSED[name]}. "
                       "Melden Sie das Werkzeug stattdessen an, wie es die Setup-Seite "
                       "beschreibt.", code=2)


def read_secret_value(name, opts):
    """Hidden on a terminal, otherwise one line from stdin."""
    if sys.stdin.isatty() and not opts["json"]:
        try:
            value = getpass.getpass(f"Wert für {name} (Eingabe bleibt unsichtbar): ")
        except (EOFError, KeyboardInterrupt):
            print()
            raise CliError("Abgebrochen, nichts geändert.")
    else:
        value = sys.stdin.readline()
    value = value.strip()
    if "\n" in value or "\r" in value:
        raise CliError("Der Wert darf keinen Zeilenumbruch enthalten.", code=2)
    return value


def cmd_agenten_schluessel(opts, args):
    if len(args) != 1:
        s = collect_agenten_status()["schluessel"]
        lines = ["Aufruf: clawbook agenten schluessel <NAME> [--entfernen] [--json]"]
        if s["benoetigt"]:
            lines.append("Benötigte Schlüssel: " + ", ".join(
                f"{n} ({'gesetzt' if n in s['gesetzt'] else 'fehlt'})" for n in s["benoetigt"]))
        raise CliError("\n".join(lines), code=2)
    name = args[0]
    check_secret_name(name)
    values = read_secrets()
    if opts["entfernen"]:
        existed = values.pop(name, None) is not None
        write_secrets(values)
        say(opts, f"Schlüssel {name} entfernt." if existed
            else f"Schlüssel {name} war nicht gesetzt.")
    else:
        value = read_secret_value(name, opts)
        if not value:
            raise CliError("Leere Eingabe, nichts geändert. Entfernen mit: clawbook agenten "
                           f"schluessel {name} --entfernen", code=2)
        values[name] = value
        write_secrets(values)
        say(opts, f"Schlüssel {name} gespeichert in {secrets_path()} (nur für Sie lesbar).")
    say(opts, "Agenten-Ausstattung wird abgeglichen ...")
    result = agenten_sync()
    if opts["json"]:
        sys.stdout.write(dump_json({"name": name, "entfernt": bool(opts["entfernen"]),
                                    "sync": result}))
    else:
        print_sync(result)
        print("Neue Terminals sehen den Schlüssel als Umgebungsvariable; laufende Agenten "
              "bitte neu starten.")
        print(f"Im aktuellen Terminal: . {SECRETS_PROFILE}")
    return 0 if result["ok"] else 1


def cmd_agenten(opts, args):
    usage = ("Aufruf: clawbook agenten [status | sync | schluessel <NAME> [--entfernen]] "
             "[--json]")
    if not args:
        if opts["json"] or not is_terminal():
            return cmd_agenten_status(opts)
        menu_agenten()
        return 0
    sub, rest = args[0], args[1:]
    if sub == "status" and not rest:
        return cmd_agenten_status(opts)
    if sub == "sync" and not rest:
        return cmd_agenten_sync(opts)
    if sub == "schluessel":
        return cmd_agenten_schluessel(opts, rest)
    raise CliError(usage, code=2)


def menu_agenten():
    """Menu "Agenten-Ausstattung": status, keys, sync."""
    while True:
        print()
        print_agenten_status(collect_agenten_status())
        print()
        print("  s  jetzt abgleichen (clawbook agenten sync)")
        print("  k  Schlüssel setzen oder ändern")
        print("  Enter  zurück")
        try:
            choice = input("Ihre Wahl: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if not choice or choice in ("0", "q", "x"):
            return
        try:
            if choice == "s":
                cmd_agenten_sync(plain())
            elif choice == "k":
                menu_agenten_key()
            else:
                print("Bitte s, k oder Enter.")
        except CliError as e:
            print(f"Fehler: {e}")


def menu_agenten_key():
    keys = collect_agenten_status()["schluessel"]
    names = keys["benoetigt"]
    print()
    print("Schlüssel für die Agenten-Ausstattung (den Wert erhalten Sie beim Anbieter")
    print("oder im Kurs, siehe die Setup-Seiten):")
    for i, n in enumerate(names, 1):
        print(f"  {i:>2}  {n:<20} {'gesetzt' if n in keys['gesetzt'] else 'fehlt'}")
    print("  oder einen anderen Namen eingeben; Enter: zurück")
    try:
        choice = input("Ihre Wahl: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return
    if not choice:
        return
    name = names[int(choice) - 1] if choice.isdigit() and 1 <= int(choice) <= len(names) \
        else choice.upper()
    cmd_agenten_schluessel(plain(), [name])


# --- menu on login ---------------------------------------------------------

def menu_off_path():
    return os.path.join(state_dir(), MENU_OFF_FILE)


def menu_on_login():
    return not os.path.exists(menu_off_path())


def set_menu_on_login(enabled):
    path = menu_off_path()
    if enabled:
        if os.path.exists(path):
            try:
                os.unlink(path)
            except PermissionError:
                rc, out = run(["sudo", "-n", "rm", "-f", path])
                if rc != 0:
                    raise CliError(f"Kann {path} nicht löschen: {out.strip()}")
        print("Das Menü öffnet sich wieder, wenn du dich per SSH anmeldest.")
    else:
        write_user_file(path, "Menü beim Anmelden per SSH abgeschaltet "
                              "(wieder einschalten: clawbook, Menü).\n")
        print("Das Menü öffnet sich beim Anmelden per SSH nicht mehr.")
        print("Du öffnest es jederzeit mit: clawbook")


# --- interactive menu ------------------------------------------------------

MENU = """
clawbook - Menü
  GitHub: {github}{restore}
  1  Status
  2  Werkzeuge prüfen
  3  Schlüssel anzeigen
  4  Stand anzeigen
  5  Stand schreiben (~/.clawbook/stand.json)
  6  Pakete und Kurse
  7  {github_item}
  8  {login_item}
  9  NotebookLM-Anmeldung prüfen
 10  Agenten-Ausstattung (MCP-Server, Skills, Schlüssel)
  0  Beenden"""


def plain(**kw):
    opts = {"json": False, "quiet": False, "private": False, "yes": False, "write": False,
            "vor_wsm": False, "vorladen": False, "pruefen": False, "dienst": False,
            "entfernen": False}
    opts.update(kw)
    return opts


def github_label(state):
    if not state["angemeldet"]:
        return "nicht angemeldet"
    if not state["geprueft"]:
        return "angemeldet (GitHub gerade nicht erreichbar)"
    return f"angemeldet als {state['benutzer'] or 'unbekannt'}"


def menu_key():
    cmd_key_show(plain())
    print()
    print("  p  privaten Schlüssel zeigen")
    print("  n  neues Schlüsselpaar erzeugen")
    print("  Enter  zurück")
    try:
        choice = input("Auswahl: ").strip().lower()
    except EOFError:
        return
    if choice == "p":
        cmd_key_show(plain(private=True))
    elif choice == "n":
        cmd_key_new(plain())


def restore_menu_line():
    r = restore_summary()
    if r["zustand"] == "laeuft":
        return f"\n  Pakete nach neuem Image: werden eingespielt ({', '.join(r['pakete'])})"
    if r["zustand"] == "fehler":
        return ("\n  Pakete nach neuem Image: FEHLER, siehe Status (1); "
                "erneut: clawbook wiederherstellen")
    return ""


def menu_choose_packages(cat, art, heading, hint):
    """Lists the packages of one kind; a number adds or removes one.
    Returns "t" for the technology submenu, None to go back."""
    items = [p for p in cat["pakete"] if p["art"] == art]
    print()
    print(heading)
    if cat["warnung"]:
        print(f"  Hinweis: {cat['warnung']}")
    if restore_state()["zustand"] == "laeuft":
        print("  Hinweis: Die Wiederherstellung nach dem neuen Image läuft noch.")
    print(f"  {hint}")
    for i, p in enumerate(items, 1):
        mark = "[x]" if p["installiert"] else "[ ]"
        print(f"  {i:>2}  {mark} {p['name']:<22} {p['beschreibung']}")
    if art == "kurs":
        print("   t  Technikpakete einzeln (für Fortgeschrittene)")
    print("   Enter  zurück")
    while True:
        try:
            choice = input("Deine Wahl: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return None
        if not choice or choice in ("0", "q", "x"):
            return None
        if choice == "t" and art == "kurs":
            return "t"
        if choice.isdigit() and 1 <= int(choice) <= len(items):
            return items[int(choice) - 1]
        print("Bitte eine Nummer aus der Liste wählen (Enter: zurück).")


def menu_toggle(p):
    """Adds or removes one package; apt shows what happens and asks."""
    print()
    if p["installiert"]:
        print(f"{p['name']} entfernen. Technikpakete, die sonst niemand braucht, gehen mit;")
        print("deine Dateien im Home bleiben.")
        cmd_pakete_remove(plain(), [p["name"]])
    else:
        print(f"{p['name']} hinzufügen ({p['beschreibung']}).")
        cmd_pakete_add(plain(), [p["name"]])


def menu_pakete():
    """Menu "Pakete und Kurse": courses first, single technology packages
    as a submenu for advanced users."""
    print("Paketquellen werden aktualisiert ...", flush=True)
    cat = collect_catalog()
    art = "kurs"
    while True:
        if art == "kurs":
            choice = menu_choose_packages(
                cat, "kurs", "Pakete und Kurse - Kurse",
                "Nummer: Kurs hinzufügen ([ ]) oder entfernen ([x]).")
        else:
            choice = menu_choose_packages(
                cat, "technik", "Technikpakete einzeln (für Fortgeschrittene)",
                "Nummer: Paket hinzufügen ([ ]) oder entfernen ([x]). "
                "Kurse bringen ihre Pakete selbst mit.")
        if choice is None:
            if art == "kurs":
                return
            art = "kurs"
            continue
        if choice == "t":
            art = "technik"
            continue
        try:
            menu_toggle(choice)
        except CliError as e:
            print(f"Fehler: {e}")
        cat = collect_catalog(update=False)


def interactive():
    terminal = is_terminal()
    github = github_state() if terminal else {"angemeldet": False, "benutzer": None,
                                              "geprueft": False}
    # GitHub first: without a login git and wsm do not work properly.
    if terminal and not github["angemeldet"] and github_offer():
        github = github_state()
    # Then, once: an outdated wsm configuration (needs the GitHub name).
    if terminal and github["angemeldet"]:
        try:
            wsm_offer()
        except CliError as e:
            print(f"Fehler: {e}")

    def menu_github():
        nonlocal github
        if github["angemeldet"]:
            github_show()
            git_identity_offer(only_if_unset=True)
        else:
            github_login()
        github = github_state()

    actions = {
        "1": lambda: cmd_status(plain()),
        "2": lambda: cmd_check(plain()),
        "3": menu_key,
        "4": lambda: cmd_stand(plain()),
        "5": lambda: cmd_stand(plain(write=True)),
        "6": menu_pakete,
        "7": menu_github,
        "8": lambda: set_menu_on_login(not menu_on_login()),
        "9": lambda: cmd_notebooklm(plain()),
        "10": menu_agenten,
    }
    while True:
        print(MENU.format(
            github=github_label(github),
            restore=restore_menu_line(),
            github_item="GitHub-Anmeldung prüfen" if github["angemeldet"] else "GitHub anmelden",
            login_item=("Menü beim Anmelden per SSH nicht mehr zeigen" if menu_on_login()
                        else "Menü beim Anmelden per SSH wieder zeigen")))
        try:
            choice = input("Deine Wahl: ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if not choice:
            continue
        if choice in ("0", "q", "x"):
            return 0
        action = actions.get(choice)
        if action is None:
            print(f"„{choice}“ gibt es nicht; wähle eine Nummer aus der Liste.")
            continue
        print()
        try:
            action()
        except CliError as e:
            print(f"Fehler: {e}")
        except KeyboardInterrupt:
            print("\nAbgebrochen.")


# --- command line ----------------------------------------------------------

FLAGS = {"--json": "json", "--quiet": "quiet", "-q": "quiet", "--private": "private",
         "--yes": "yes", "-y": "yes", "--write": "write", "--vor-wsm": "vor_wsm",
         "--vorladen": "vorladen", "--pruefen": "pruefen", "--dienst": "dienst",
         "--entfernen": "entfernen"}


def version_text():
    commit = read_build().get("commit") or "unbekannt"
    return f"clawbook (Schnittstelle {SCHNITTSTELLE}, Build {commit})"


def dispatch(words, opts):
    cmd, args = words[0], words[1:]
    if cmd == "status" and not args:
        return cmd_status(opts)
    if cmd == "check" and not args:
        return cmd_check(opts)
    if cmd == "key":
        if args == ["show"]:
            return cmd_key_show(opts)
        if args == ["new"]:
            return cmd_key_new(opts)
        raise CliError("Aufruf: clawbook key show [--private] | clawbook key new [--yes]",
                       code=2)
    if cmd == "stand" and not args:
        return cmd_stand(opts)
    if cmd == "kurse" and not args:
        return cmd_kurse(opts)
    if cmd == "kurs":
        return cmd_kurs(opts, args)
    if cmd == "pakete":
        return cmd_pakete(opts, args)
    if cmd == "wiederherstellen" and not args:
        return cmd_wiederherstellen(opts)
    if cmd == "github":
        return cmd_github(opts, args)
    if cmd == "notebooklm" and not args:
        return cmd_notebooklm(opts)
    if cmd == "wsm":
        return cmd_wsm(opts, args)
    if cmd == "agenten":
        if os.geteuid() == 0:
            # Agent configuration belongs to the working user: run as student.
            sys.stdout.flush()
            cmd = as_user_env([sys.executable, "-I", os.path.abspath(__file__)] + ARGV)
            os.execvp(cmd[0], cmd)
        return cmd_agenten(opts, args)
    raise CliError(f"Unbekannter Befehl: {' '.join(words)} (Hilfe: clawbook --help)",
                   code=2)


ARGV = []


def main(argv):
    ARGV[:] = argv
    try:
        sys.stdout.reconfigure(encoding="utf-8")
    except (AttributeError, ValueError):
        pass
    opts = plain()
    words = []
    for a in argv:
        if a in ("-h", "--help", "help"):
            sys.stdout.write(HELP)
            return 0
        if a == "--version":
            print(version_text())
            return 0
        if a in FLAGS:
            opts[FLAGS[a]] = True
        elif a.startswith("-"):
            words = None
            bad = a
            break
        else:
            words.append(a)
    try:
        if words is None:
            raise CliError(f"Unbekannte Option: {bad} (Hilfe: clawbook --help)", code=2)
        if not words:
            if opts["json"]:
                raise CliError("--json braucht einen Befehl, z. B. clawbook status --json",
                               code=2)
            return interactive()
        return dispatch(words, opts)
    except CliError as e:
        if opts["json"]:
            sys.stdout.write(dump_json({"fehler": str(e)}))
        else:
            print(f"clawbook: {e}", file=sys.stderr)
        return e.code
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
