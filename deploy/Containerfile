# clawbook-lehre: a workstation image for working with AI agents.
#
# Build (all versions come from deploy/versions.env):
#   podman build -f deploy/Containerfile \
#     $(grep -v '^#' deploy/versions.env | grep . | sed 's/^/--build-arg /') .
#
# Layers are ordered by how often they change: base system first,
# runtimes next, agent CLIs and tools after that, image defaults last.
# Tools live outside /home/student, so a new image updates them even when
# the home directory is a persistent volume.

FROM debian:trixie-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=de_DE.UTF-8 \
    LC_ALL=de_DE.UTF-8 \
    TZ=Europe/Berlin

# --- Base system -----------------------------------------------------------
# hadolint ignore=DL3008
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash-completion ca-certificates curl git gnupg iproute2 jq less locales \
      nano openssh-client openssh-server procps python3 python3-pip \
      python3-venv python-is-python3 pipx sudo tmux tzdata unzip vim-tiny \
      wget xz-utils \
      chromium fonts-dejavu-core openssl samba weston x11-xserver-utils \
      xterm xwayland \
 && sed -i 's/^# *de_DE.UTF-8 UTF-8/de_DE.UTF-8 UTF-8/; s/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
 && locale-gen \
 && rm -rf /var/lib/apt/lists/*

# --- Process supervisor ----------------------------------------------------
# s6-overlay runs several services (SSH, RDP, Samba) in one container,
# restarts them when they crash and runs the init step before them.
ARG S6_OVERLAY_VERSION
RUN test -n "${S6_OVERLAY_VERSION}" \
 && for part in noarch x86_64; do \
      curl -fsSLo "/tmp/s6-${part}.tar.xz" \
        "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-${part}.tar.xz" \
   && curl -fsSL "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-${part}.tar.xz.sha256" \
        | sed "s#s6-overlay-${part}.tar.xz#/tmp/s6-${part}.tar.xz#" | sha256sum -c - \
   && tar -C / -Jxpf "/tmp/s6-${part}.tar.xz" \
   && rm "/tmp/s6-${part}.tar.xz"; \
    done

ENV S6_KEEP_ENV=1 \
    S6_BEHAVIOUR_IF_STAGE2_FAILS=2 \
    S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0 \
    S6_VERBOSITY=1

# --- Working user ------------------------------------------------------------
# Fixed UID 1000: the usual UID of the first user in a WSL distribution, so
# file ownership matches on bind mounts. Passwordless sudo: the container is
# the student's own machine.
# The password field "*" means "no password", not "locked": key login works.
RUN useradd --create-home --uid 1000 --shell /bin/bash student \
 && usermod -p '*' student \
 && echo 'student ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/student \
 && chmod 0440 /etc/sudoers.d/student

# --- Runtimes ----------------------------------------------------------------
ARG NODE_VERSION
WORKDIR /tmp
RUN test -n "${NODE_VERSION}" \
 && curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
 && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" \
      | grep " node-v${NODE_VERSION}-linux-x64.tar.xz\$" | sha256sum -c - \
 && tar -xJf "node-v${NODE_VERSION}-linux-x64.tar.xz" -C /usr/local --strip-components=1 \
      --exclude='*/CHANGELOG.md' --exclude='*/LICENSE' --exclude='*/README.md' \
 && rm "node-v${NODE_VERSION}-linux-x64.tar.xz" \
 && node --version && npm --version

ARG UV_VERSION
RUN test -n "${UV_VERSION}" \
 && curl -fsSL "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" \
      | tar -xz -C /usr/local/bin --strip-components=1 \
 && uv --version

ARG GH_VERSION
RUN test -n "${GH_VERSION}" \
 && curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" \
      | tar -xz -C /usr/local --strip-components=1 \
 && gh --version

# --- Agent CLIs --------------------------------------------------------------
# Installed globally (outside the home directory). Self-updates stay off so
# the image is what was tested; updates come with a new image.
ENV DISABLE_AUTOUPDATER=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false

ARG CLAUDE_CODE_VERSION
ARG CODEX_VERSION
ARG COPILOT_VERSION
ARG OPENCODE_VERSION
RUN test -n "${CLAUDE_CODE_VERSION}" -a -n "${CODEX_VERSION}" \
         -a -n "${COPILOT_VERSION}" -a -n "${OPENCODE_VERSION}" \
 && npm install -g --omit=dev \
      "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
      "@openai/codex@${CODEX_VERSION}" \
      "@github/copilot@${COPILOT_VERSION}" \
      "opencode-ai@${OPENCODE_VERSION}" \
 && npm cache clean --force

# Antigravity has no versioned installer; it installs the current release.
RUN curl -fsSL https://antigravity.google/cli/install.sh | bash -s -- --dir /usr/local/bin \
 && test -x /usr/local/bin/agy

# --- Further tools -----------------------------------------------------------
# Browsers for every Playwright copy in the image live in one shared place.
# playwright-cli and Playwright-MCP use Chrome by default, which the image
# does not have; PLAYWRIGHT_MCP_BROWSER (read by both) switches them to the
# Chromium that Playwright installs.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    PLAYWRIGHT_MCP_BROWSER=chromium \
    UV_TOOL_DIR=/opt/uv-tools \
    UV_TOOL_BIN_DIR=/usr/local/bin

ARG PLAYWRIGHT_VERSION
ARG PLAYWRIGHT_CLI_VERSION
ARG PLAYWRIGHT_MCP_VERSION
ARG WIKIJS_MCP_VERSION
# playwright-cli and Playwright-MCP bring their own playwright-core, often
# a newer one that expects another Chromium revision: install Chromium for
# every copy (without the extra headless shell, which they do not use).
RUN test -n "${PLAYWRIGHT_VERSION}" -a -n "${PLAYWRIGHT_CLI_VERSION}" \
         -a -n "${PLAYWRIGHT_MCP_VERSION}" -a -n "${WIKIJS_MCP_VERSION}" \
 && npm install -g --omit=dev \
      "playwright@${PLAYWRIGHT_VERSION}" \
      "@playwright/cli@${PLAYWRIGHT_CLI_VERSION}" \
      "@playwright/mcp@${PLAYWRIGHT_MCP_VERSION}" \
      "@cahaseler/wikijs-mcp@${WIKIJS_MCP_VERSION}" \
 && npm cache clean --force \
 && playwright install --with-deps chromium \
 && find /usr/local/lib/node_modules -type f \
      -path '*/node_modules/playwright-core/package.json' -printf '%h\n' \
    | while read -r core; do \
        node "${core}/cli.js" install --with-deps --no-shell chromium || exit 1; \
      done \
 && chmod -R a+rX /opt/ms-playwright \
 && rm -rf /var/lib/apt/lists/*

# notebooklm-py with its browser extra: "clawbook notebooklm anmelden" (and
# "notebooklm login") open Chromium through the Python Playwright, pinned to a release whose Chromium is
# already in /opt/ms-playwright.
ARG GRAPHIFY_VERSION
ARG NOTEBOOKLM_VERSION
ARG PLAYWRIGHT_PYTHON_VERSION
RUN test -n "${GRAPHIFY_VERSION}" -a -n "${NOTEBOOKLM_VERSION}" \
         -a -n "${PLAYWRIGHT_PYTHON_VERSION}" \
 && uv tool install "graphifyy==${GRAPHIFY_VERSION}" \
 && uv tool install "notebooklm-py[browser]==${NOTEBOOKLM_VERSION}" \
      --with "playwright==${PLAYWRIGHT_PYTHON_VERSION}" \
 && /opt/uv-tools/notebooklm-py/bin/python -m playwright install chromium \
 && chmod -R a+rX /opt/uv-tools \
 && uv cache clean

# Every Playwright "install" (also "playwright-cli install --skills" for an
# already present browser) takes a lock in the browser directory and notes
# its own path under .links. Only these two places become writable for the
# group "student"; the installed browsers stay read-only.
RUN chgrp student /opt/ms-playwright \
 && chgrp -R student /opt/ms-playwright/.links \
 && chmod 2775 /opt/ms-playwright /opt/ms-playwright/.links \
 && find /opt/ms-playwright/.links -type f -exec chmod g+w {} +

# WorkspaceManager from the vendored wheel, checksum pinned in versions.env.
# Its entry point goes to /opt/clawbook/tool-bin: /usr/local/bin/wsm is a
# wrapper (from rootfs) that asks for the GitHub login before wsm writes
# its first configuration, then hands over to the real wsm.
ARG WSM_VERSION
ARG WSM_SHA256
COPY vendor/wsm/ /tmp/wsm/
RUN test -n "${WSM_VERSION}" -a -n "${WSM_SHA256}" \
 && echo "${WSM_SHA256}  /tmp/wsm/wsm-${WSM_VERSION}-py3-none-any.whl" | sha256sum -c - \
 && UV_TOOL_BIN_DIR=/opt/clawbook/tool-bin \
      uv tool install "/tmp/wsm/wsm-${WSM_VERSION}-py3-none-any.whl" \
 && test -x /opt/clawbook/tool-bin/wsm \
 && chmod -R a+rX /opt/uv-tools/wsm \
 && rm -rf /tmp/wsm \
 && uv cache clean

# --- Image defaults ----------------------------------------------------------
# Also the source of the technology and course packages (clawbook-apt) with
# its key, and the apt cache in the home volume. No apt-get after this
# point: the build does not need the package source, and apt would now
# write into /home/student (cont-init.d/10-clawbook prepares it at start).
COPY deploy/rootfs/ /

RUN chmod 0755 /etc/cont-init.d/10-clawbook /etc/services.d/*/run \
               /usr/local/bin/clawbook /usr/local/bin/clawbook-* \
               /usr/local/bin/notebooklm-fix-cookies /usr/local/bin/wsm \
 && chmod 0644 /etc/profile.d/zz-clawbook-menu.sh /etc/profile.d/clawbook-secrets.sh \
               /usr/share/keyrings/clawbook-apt.gpg \
               /etc/apt/sources.list.d/clawbook.sources /etc/apt/apt.conf.d/zz-clawbook-cache \
               /etc/dpkg/dpkg.cfg.d/zz-clawbook-doc \
 && chmod -R a+rX /usr/share/clawbook \
 && { printf '%s\n' '# clawbook: keys for the agent tools (clawbook agenten schluessel); before' \
        '# the interactive check, because bash run by sshd for "ssh host <cmd>"' \
        '# reads this file instead of BASH_ENV.' \
        '. /etc/profile.d/clawbook-secrets.sh' ''; cat /etc/bash.bashrc; } > /tmp/bash.bashrc \
 && mv /tmp/bash.bashrc /etc/bash.bashrc && chmod 0644 /etc/bash.bashrc \
 && install -d -m 0755 /home/student/.clawbook/apt/archives /home/student/.clawbook/apt/lists \
 && install -d -m 0700 -o _apt -g root /home/student/.clawbook/apt/archives/partial \
      /home/student/.clawbook/apt/lists/partial \
 && mkdir -p /run/sshd

# Keys of the agent equipment (~/.clawbook/secrets) also for non-interactive
# bash, e.g. "docker exec ... bash -c" (SSH sessions: /etc/environment);
# login shells read profile.d, interactive shells and "ssh host <cmd>"
# /etc/bash.bashrc.
ENV BASH_ENV=/etc/profile.d/clawbook-secrets.sh

ARG CLAWBOOK_BUILD=unknown
RUN printf 'commit=%s\nbuilt=%s\n' "${CLAWBOOK_BUILD}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      > /etc/clawbook-build

WORKDIR /home/student
# 22 SSH, 3389 RDP (Weston), 445 Samba
EXPOSE 22 3389 445

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["bash", "-c", "for p in 22 3389 445; do (exec 3<>/dev/tcp/127.0.0.1/$p) || exit 1; done"]

# s6-overlay is PID 1 (as root): init step, then the services, then the
# main command - a shell for "student" when a terminal is attached.
ENTRYPOINT ["/init"]
CMD ["/usr/local/bin/clawbook-shell"]
