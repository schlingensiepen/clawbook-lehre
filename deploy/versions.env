# Pinned tool versions for the image (one KEY=VALUE per line).
# Every value is passed to the build as a build argument of the same name.
# Raise versions on purpose; .github/workflows/check-versions.yml reports
# newer releases once a week.

# Process supervisor
S6_OVERLAY_VERSION=3.2.3.2

# Runtimes
NODE_VERSION=22.23.3
UV_VERSION=0.12.22
GH_VERSION=2.102.0

# Agent CLIs (npm)
CLAUDE_CODE_VERSION=2.1.287
CODEX_VERSION=0.160.0
COPILOT_VERSION=1.0.91
OPENCODE_VERSION=1.18.34

# Further tools
PLAYWRIGHT_VERSION=1.63.0
PLAYWRIGHT_CLI_VERSION=0.1.22
PLAYWRIGHT_MCP_VERSION=0.0.83
WIKIJS_MCP_VERSION=1.0.5
GRAPHIFY_VERSION=0.9.73
NOTEBOOKLM_VERSION=0.8.4

# WorkspaceManager, vendored wheel in vendor/wsm/ (not checked online)
WSM_VERSION=1.1.0
WSM_SHA256=4644a6ae521879196092bd737f67f615a1bb4e90c4b76186e7626baa2794e8d5
